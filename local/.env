# Database Configuration
POSTGRES_VERSION=13
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_password
POSTGRES_DB=postgres

# Hasura Database
HASURA_DB_DATABASE=test_hasura
HASURA_DB_USER=test_hasura
HASURA_DB_PASSWORD=hasura_db_password

# Keycloak Database
KEYCLOAK_DB_DATABASE=test_keycloak
KEYCLOAK_DB_USER=test_keycloak
KEYCLOAK_DB_PASSWORD=keycloak_db_password

# B3 Database
B3_PG_DATABASE=test_b3
B3_PG_USER=test_b3
B3_PG_PASSWORD=b3_db_password

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=rabbitmq_local_password
RABBITMQ_DEFAULT_VHOST=/

# ImmuDB Configuration
IMMUDB_USER=immudb
IMMUDB_PASSWORD=immudb_local_password
IMMUDB_INDEX_DB=indexdb

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=election-event-documents
MINIO_PUBLIC_BUCKET=public

# AWS/S3 Configuration (for local development)
AWS_REGION=eu-west-1
AWS_S3_BUCKET=election-event-documents
AWS_S3_PUBLIC_BUCKET=public
AWS_S3_PRIVATE_URI=http://minio:9000
AWS_S3_PUBLIC_URI=http://minio:9000
AWS_S3_FETCH_EXPIRATION_SECS=3600
AWS_S3_UPLOAD_EXPIRATION_SECS=120
AWS_S3_MAX_UPLOAD_BYTES=5368709120
AWS_S3_JWKS_CACHE_POLICY=max-age=30

# Hasura Configuration
HASURA_GRAPHQL_ADMIN_SECRET=hasura_admin_secret
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_CORS_DOMAIN=*
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=unauthorized

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_CLIENT_ID=keycloak
KEYCLOAK_ADMIN_CLIENT_SECRET=admin_client_secret
KEYCLOAK_CLIENT_ID=service-account
KEYCLOAK_CLIENT_SECRET=zh0GWEjbynXJDcpF1YipFXUleEKTQiO0
KEYCLOAK_PUBLIC_URL=http://keycloakx:8080/auth
KEYCLOAK_URL=http://keycloakx:8080/auth

# Environment Configuration
ENV_SLUG=local
APP_VERSION=v9.3.0-rc.19
LOG_LEVEL=debug

# Application URLs
VOTING_PORTAL_URL=http://localhost:8000
BALLOT_VERIFIER_URL=http://localhost:8001
HASURA_ENDPOINT=http://hasura:8080/v1/graphql

# Worker Configuration
WORKER_THREADS=1
DEFAULT_SQL_BATCH_SIZE=100000
DEFAULT_SQL_LIMIT=50000
LOW_SQL_LIMIT=50000

# Rust Configuration
RUST_BACKTRACE=full
CARGO_TERM_COLOR=always
RUSTFLAGS=-Awarnings

# Other Configuration
DEMO_PUBLIC_KEY=eh8l6lsmKSnzhMewrdLXEKGe9KVxxo//QsCT2wwAkBo
