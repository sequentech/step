# Generated by Cargo
# will have compiled files and executables
target/
rust-*-target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
#Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

__pycache__/
rust-toolchain

# OS X
.DS_Store

# generated by running rust bench
output.txt

# python
*.pyc

# Nix
result
/pkg/

pkg
.direnv

# Devenv
.devenv*
devenv.local.nix
.pre-commit-config.yaml
.devcontainer/.env
.devcontainer/nginx/default.conf

# Frontend
node_modules/

# setup for workspace config plus plugin, that uses multiple .vscode/ settings
.vscode/*
!.vscode/*.shared.json

# coredumps
packages/rustc-ice*

# ignoring e2e downloaded files
**/e2e/downloads
packages/admin-portal/tests_output
packages/voting-portal/tests_output
packages/ballot-verifier/tests_output
packages/admin-portal/logs
packages/voting-portal/logs
packages/ballot-verifier/logs

# generated by the load-testing scripts (docs/docusaurus/docs/07-developers/12-ivr
# and docs/docusaurus/docs/07-developers/02-cli/02-tutorials/load-testing)
packages/step-cli/scripts/telephone-load-test-output/
packages/step-cli/scripts/online-load-test-output/
# holds real per-server credentials — copy layers.yaml.example here as
# config/layers.yaml instead
packages/step-cli/scripts/telephone-load-test-inputs/config/
# extra safety net: nothing tracked lives directly in scripts/ itself (real
# configs belong under telephone-load-test-inputs/config/ above) — catches
# a credentials-bearing YAML dropped at the wrong level before it's staged
packages/step-cli/scripts/*.yaml
packages/voting-portal/test-results/

# ignore artifacts for airgapped environments
airgapped-artifacts