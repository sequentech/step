# Secrets the bundle never carries: each placeholder is replaced with a
# generated value once, before anything is removed or started, and none may be
# left blank. MESSAGING_RELAY_SECRET is shared by messaging-webhooks and
# harvest; the renderer token by harvest and the renderer; the Scanovate keys by
# its services (and the callback secret by the realm's Scanovate step).
SECRET_PLACEHOLDER="generate-on-first-up"
for key in MESSAGING_RELAY_SECRET MONITORING_RENDERER_TOKEN \
    SCANOVATE_LIVENESS_JWT_SECRET_KEY SCANOVATE_OCR_JWT_SECRET_KEY SCANOVATE_LIVENESS_CALLBACK_SECRET; do
    if grep -q "^${key}=\"${SECRET_PLACEHOLDER}\"" .env; then
        sed -i "s|^${key}=.*|${key}=\"$(openssl rand -hex 32)\"|" .env
        echo "Generated ${key} in .env"
    fi
    value=$(sed -n "s/^${key}=\"\{0,1\}\([^\"]*\)\"\{0,1\}$/\1/p" .env)
    if [ -z "$value" ] || [ "$value" = "$SECRET_PLACEHOLDER" ]; then
        echo "Error: ${key} in .env is blank; set it to the output of 'openssl rand -hex 32'."
        exit 1
    fi
done
unset value

# Biometric services: carried by every full bundle (biometric.json says so),
# started only when BIOMETRIC_SERVICES is "start".
BIOMETRIC_SERVICES=$(sed -n 's/^BIOMETRIC_SERVICES="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' .env)
BIOMETRIC_IN_BUNDLE=$(jq -r '.biometric // "absent"' biometric.json 2>/dev/null || echo absent)
PROFILES=(--profile full)
case "$BIOMETRIC_SERVICES" in
    start)
        if [ "$BIOMETRIC_IN_BUNDLE" != "included" ]; then
            echo "Error: this bundle is a DEVELOPER PARTIAL build without the Scanovate images;"
            echo "set BIOMETRIC_SERVICES=\"stopped\" in .env. Biometric enrollment does not work here."
            exit 1
        fi
        # The images are named by digest, which only Docker's containerd
        # image store keeps when loading an OCI archive.
        if ! docker info --format '{{.DriverStatus}}' 2>/dev/null | grep -q 'io.containerd.snapshotter'; then
            echo "Error: the biometric images need Docker's containerd image store (Docker 29's default)."
            exit 1
        fi
        mkdir -p scanovate/liveness
        CALLBACK=$(sed -n 's/^SCANOVATE_LIVENESS_CALLBACK_SECRET="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' .env)
        sed "s|__LIVENESS_CALLBACK_SECRET__|${CALLBACK}|g" scanovate/liveness/service_config.json.tmpl \
            > scanovate/liveness/service_config.json
        chmod 600 scanovate/liveness/service_config.json
        unset CALLBACK
        PROFILES+=(--profile biometric)
        echo "Biometric services (Scanovate): START."
        ;;
    stopped)
        echo "Biometric services (Scanovate): NOT STARTED (BIOMETRIC_SERVICES=stopped). Their images"
        echo "are in the bundle (${BIOMETRIC_IN_BUNDLE}), but biometric enrollment does not work here."
        ;;
    *)
        echo "Error: BIOMETRIC_SERVICES in .env must be \"start\" or \"stopped\"."
        exit 1
        ;;
esac

# Add two optional input params: <ezip_path> <password>
# With an empty <password> or "-", the password is read without echo.
ezip_path="$1"
password="$2"

if [[ -n "$ezip_path" && ( -z "$password" || "$password" == "-" ) ]]; then
    read -rsp "Password for $ezip_path: " password
    echo
    if [[ -z "$password" ]]; then
        echo "Error: a password is required to decrypt $ezip_path"
        exit 1
    fi
fi

cd janitor && source setup.sh; cd ..
if [ "$3" ]; then
    TENANT_CONFIG=./keycloak/import/tenant-90505c8a-23a9-4cdf-a26b-4e19f6a097d5.json
    echo "Patching Tenant config with $3"
    python3 ./janitor/patch.py $TENANT_CONFIG $3 admin --overwrite
fi

echo "Cleaning up docker env"

docker ps -aq | xargs docker rm -f
docker images -q | xargs docker rmi -f
docker volume ls -q | xargs docker volume rm -f
docker network ls -q | xargs docker network rm -f
docker system prune -f

echo "Loading environment variables..."
source .env
# Host-side requests must target the address the ports are published on.
HASURA_HOST="${BIND_ADDRESS:-127.0.0.1}"
if [[ "$HASURA_HOST" == "0.0.0.0" ]]; then
    HASURA_HOST=127.0.0.1
fi
echo "Creating resources..."
mkdir -p simplesaml
touch simplesaml/{authsources,saml20-sp-remote}.php
echo "Loading images..."
find images -type f -name "*.tar" | xargs -I{} docker load --input {}

set -eo pipefail

# Function to cleanup docker containers
cleanup() {
    echo "Shutting down docker containers..."
    docker compose down
}

# Trap SIGINT and EXIT signals to ensure cleanup is performed
trap cleanup SIGINT EXIT

if [[ -n "$ezip_path" && -n "$password" ]]; then
    echo "Decrypting trustees data..."

    # Delete (if it exists) folder trustees-data, and recreate it again
    rm -rf trustees-data
    mkdir -m 700 trustees-data

    # Decrypt the file in ezip_path
    TRUSTEES_EXPORT_PASSWORD="$password" openssl enc -d -aes-256-cbc -in "$ezip_path" -out trustees-data/trustees-export.zip -pass env:TRUSTEES_EXPORT_PASSWORD -md md5

    # Extract the decrypted zip with unzip (inside the folder trustees-data)
    cd trustees-data
    unzip trustees-export.zip
    cd ..

    echo "Trustees data decrypted and extracted."
fi

update_trustee_public_keys() {
    # Check if KEYCLOAK_ADMIN_CLIENT_SECRET is set
    if [ -z "$KEYCLOAK_ADMIN_CLIENT_SECRET" ]; then
        echo "Error: KEYCLOAK_ADMIN_CLIENT_SECRET is not set."
        return 1
    fi

    # List all folders in trustees-data
    for dir in trustees-data/*; do
        if [ -d "$dir" ]; then
            # Get the trustee name from the directory name
            TRUSTEE_NAME=$(basename "$dir")
            toml_file="$dir/$TRUSTEE_NAME.toml"

            # Check if the TOML file exists
            if [ -f "$toml_file" ]; then
                # Derive public keys with the same native tool as the runner.
                PUBLIC_KEYS=$(docker compose --profile full run --rm --no-deps --entrypoint /usr/bin/trustee "$TRUSTEE_NAME" public-keys --trustee-config /opt/trustee/trustee.toml) || return 1
                PUBLIC_KEY=$(printf '%s' "$PUBLIC_KEYS" | jq -er '.signing_public_key') || return 1
                SHARE_PUBLIC_KEY=$(printf '%s' "$PUBLIC_KEYS" | jq -er '.share_encryption_public_key') || return 1

                # Check if PUBLIC_KEY is not empty
                if [ -n "$PUBLIC_KEY" ]; then
                    # Construct JSON data using jq
                    JSON_DATA=$(jq -n \
                        --arg trustee_name "$TRUSTEE_NAME" \
                        --arg public_key "$PUBLIC_KEY" \
                        --arg share_public_key "$SHARE_PUBLIC_KEY" \
                        '{
                            "type": "update",
                            "args": {
                                "source": "backend-db",
                                "table": {"schema": "sequent_backend", "name": "trustee"},
                                "$set": {"public_key": $public_key, "share_encryption_public_key": $share_public_key},
                                "$default": [],
                                "where": {"name": $trustee_name}
                            }
                        }')

                    # Perform the curl request and capture response body and HTTP status code
                    RESPONSE=$(curl -s -w "|||%{http_code}" "http://$HASURA_HOST:8080/v2/query" \
                        -H 'Accept: */*' \
                        -H 'Cache-Control: no-cache' \
                        -H 'Content-Type: application/json' \
                        -H 'Hasura-Client-Name: hasura-console' \
                        -H "Origin: http://$HASURA_HOST:8080" \
                        -H "x-hasura-admin-secret: $KEYCLOAK_ADMIN_CLIENT_SECRET" \
                        --data-raw "$JSON_DATA")

                    # Separate the response body and HTTP status code using parameter expansion
                    HTTP_BODY="${RESPONSE%|||*}"
                    HTTP_STATUS="${RESPONSE##*|||}"

                    # Check if HTTP status code is 200 and affected_rows is 1
                    if [ "$HTTP_STATUS" -eq 200 ]; then
                        AFFECTED_ROWS=$(echo "$HTTP_BODY" | jq '.affected_rows')

                        if [ "$AFFECTED_ROWS" -eq 1 ]; then
                            echo "Successfully updated trustee '$TRUSTEE_NAME' with public key."
                        else
                            echo "Failed to update trustee '$TRUSTEE_NAME'. affected_rows: $AFFECTED_ROWS"
                        fi
                    else
                        echo "HTTP request failed for trustee '$TRUSTEE_NAME' with status code $HTTP_STATUS"
                        echo "Response body: $HTTP_BODY"
                    fi
                else
                    echo "Public key not found in '$toml_file'"
                fi
            else
                echo "TOML file '$toml_file' not found for trustee '$TRUSTEE_NAME'"
            fi
        fi
    done
}

echo "Starting environment..."
docker compose "${PROFILES[@]}" up -d

if [[ -n "$ezip_path" && -n "$password" ]]; then
    # Wait until GraphQL is up
    echo "Waiting for GraphQL to be up..."

    # Maximum number of retries
    MAX_RETRIES=60
    RETRY_INTERVAL=10 # seconds

    for ((i=1;i<=MAX_RETRIES;i++)); do
        if curl -s http://$HASURA_HOST:8080/healthz >/dev/null; then
            echo "GraphQL is up!"
            break
        else
            echo "Waiting for GraphQL ($i/$MAX_RETRIES)..."
            sleep $RETRY_INTERVAL
        fi
    done

    if [ "$i" -gt "$MAX_RETRIES" ]; then
        echo "GraphQL did not become available after $((MAX_RETRIES*RETRY_INTERVAL)) seconds."
        exit 1
    fi

    # Call the function to update trustee public keys
    update_trustee_public_keys
fi

# Attach to docker compose logs
echo "Attaching to Docker Compose logs. Press Ctrl+C to stop and shut down containers."
docker compose logs -f
