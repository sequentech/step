# Build after scripts/e2e run passed at this revision; environments pin its digest.
FROM step-e2e-tools:local AS tools
FROM mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e
RUN apt-get update && apt-get install -y --no-install-recommends python3-yaml \
    && rm -rf /var/lib/apt/lists/* && corepack enable && corepack prepare yarn@1.22.22 --activate
COPY --from=tools /usr/local/bin/k6 /usr/local/bin/k6
COPY packages/e2e/package.json /tmp/e2e-package.json
COPY packages/yarn.lock /workspaces/step/packages/yarn.lock
WORKDIR /workspaces/step/packages
# Keep the deployable image independent of Storybook/build-time dependencies.
# Resolve these two runtime requirements from the same package and lockfile.
RUN node -e "const fs=require('fs'); const d=require('/tmp/e2e-package.json').devDependencies; fs.writeFileSync('package.json', JSON.stringify({private:true,dependencies:{'@playwright/test':d['@playwright/test'],pg:d.pg}}));" \
    && yarn install --frozen-lockfile --ignore-scripts --non-interactive && yarn cache clean
COPY --chown=1000:1000 packages/e2e /workspaces/step/packages/e2e
COPY --chown=1000:1000 packages/voting-portal/test/load /workspaces/step/packages/voting-portal/test/load
COPY --chown=1000:1000 packages/voting-portal/test/e2e /workspaces/step/packages/voting-portal/test/e2e
COPY --chown=1000:1000 packages/admin-portal/test/e2e /workspaces/step/packages/admin-portal/test/e2e
COPY --chown=1000:1000 packages/ballot-verifier/test/e2e /workspaces/step/packages/ballot-verifier/test/e2e
COPY --chown=1000:1000 packages/results-portal/test/e2e /workspaces/step/packages/results-portal/test/e2e
COPY --chown=1000:1000 .e2e/bin/normal/step-cli /workspaces/step/.e2e/bin/normal/step-cli
COPY --chown=1000:1000 scripts/e2e /workspaces/step/scripts/e2e
RUN mkdir -p /workspaces/step/.e2e/runs && chown -R 1000:1000 /workspaces/step/.e2e
USER 1000
ENV HOME=/tmp PYTHONPATH=/workspaces/step/packages
WORKDIR /workspaces/step
CMD ["python3", "scripts/e2e", "--help"]
