################################################################################
# .env.remote-deployment.example
# This is an example .env file for a remote test environment using a reverse proxy.
# Copy this to .env and fill in the values.

################################################################################
# Docker Compose Configuration
COMPOSE_PROFILES=full
COMPOSE_PROJECT_NAME=step_remote_test

################################################################################
# General
ENV_SLUG=os
APP_VERSION=0.0.1
APP_HASH=dev

# --- NEW: Reverse Proxy Domain Configuration ---
# The root domain managed by Cloudflare.
DOMAIN=sequent.vote

# Logging
LOG_LEVEL=info
RUST_BACKTRACE=1
CARGO_TERM_COLOR=always
HASURA_GRAPHQL_ENABLED_LOG_TYPES=startup, http-log, webhook-log, websocket-log, query-log
HASURA_GRAPHQL_ADMIN_SECRET=admin

# Ports
# Note: These ports are for internal container communication.
# Public access will be managed by the Nginx reverse proxy on ports 80/443.
HARVEST_PORT=8000
MOCK_SERVER_PORT=8082
KC_HTTP_PORT=8090
ADMIN_PORTAL_PORT=3002
VOTING_PORTAL_PORT=3000
HASURA_PORT=8080
MINIO_PORT=9000

# URLs and Hostnames
KC_HOSTNAME="https://login-remote-deployment.${DOMAIN}"
KC_HOSTNAME_STRICT=false
KEYCLOAK_URL=http://keycloak:${KC_HTTP_PORT}
KEYCLOAK_PUBLIC_URL=${KC_HOSTNAME}
HARVEST_DOMAIN=harvest:${HARVEST_PORT}
HASURA_ENDPOINT=https://hasura-remote-deployment.${DOMAIN}/v1/graphql
VOTING_PORTAL_URL=https://voting-remote-deployment.${DOMAIN}
RESULTS_PORTAL_URL=https://results-remote-deployment.${DOMAIN}
ADMIN_PORTAL_URL=https://admin-remote-deployment.${DOMAIN}
VOTING_PORTAL_HOSTNAME=voting-remote-deployment.${DOMAIN}
ADMIN_PORTAL_HOSTNAME=admin-remote-deployment.${DOMAIN}
IDP_BASE_URL=http://simplesamlphp:8083/simplesaml
SP_BASE_URL=https://${KC_HOSTNAME}
IMMUDB_SERVER_URL=http://immudb:3322
VAULT_SERVER_URL=http://vault:8200
B3_URL=http://b3:50051
BALLOT_VERIFIER_URL=https://voting-remote-deployment.${DOMAIN}
AWS_S3_PUBLIC_URI=https://minio-remote-deployment.${DOMAIN}
ROCKET_ADDRESS=0.0.0.0

# Hasura
HASURA_PG_PASSWORD=postgrespassword
HASURA_PG_USER=postgres
HASURA_PG_PORT=5432
HASURA_PG_DBNAME=postgres
HASURA_PG_HOST=postgres
HASURA_GRAPHQL_METADATA_DATABASE_URL=postgres://${HASURA_PG_USER}:${HASURA_PG_PASSWORD}@${HASURA_PG_HOST}:${HASURA_PG_PORT}/${HASURA_PG_DBNAME}
HASURA_PG_DATABASE_URL=postgres://${HASURA_PG_USER}:${HASURA_PG_PASSWORD}@${HASURA_PG_HOST}:${HASURA_PG_PORT}/${HASURA_PG_DBNAME}
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_DEV_MODE=true
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=unauthorized
HASURA_GRAPHQL_MIGRATIONS_DIR=/workspaces/step/hasura/migrations
HASURA_GRAPHQL_METADATA_DIR=/workspaces/step/hasura/metadata
HASURA_GRAPHQL_CONSOLE_ASSETS_DIR=/srv/console-assets
HASURA_GRAPHQL_METADATA_DEFAULTS={"backend_configs":{"dataconnector":{"athena":{"uri":"http://data-connector-agent:8081/api/v1/athena"},"mariadb":{"uri":"http://data-connector-agent:8081/api/v1/mariadb"},"mysql8":{"uri":"http://data-connector-agent:8081/api/v1/mysql"},"oracle":{"uri":"http://data-connector-agent:8081/api/v1/oracle"},"snowflake":{"uri":"http://data-connector-agent:8081/api/v1/snowflake"}}}}
HASURA_GRAPHQL_MIGRATIONS_SERVER_TIMEOUT=60

# Keycloak
KC_DB=postgres
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=postgrespassword
KC_DB_SCHEMA=public
KC_DB_URL_HOST=postgres-keycloak
KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_ID=service-account
# Note: Client secrets will be generated by configure-environment.sh
KEYCLOAK_CLIENT_SECRET=zh0GWEjbynXJDcpF1YipFXUleEKTQiO0
KEYCLOAK_ADMIN_CLIENT_ID=admin
KEYCLOAK_ADMIN_CLIENT_SECRET=admin
KEYCLOAK_CLI_CLIENT_ID=admin-portal
KEYCLOAK_CLI_CLIENT_SECRET=wBy8rpuKQxPWikQ3rIFv9g42t0WK0Xiu
SUPER_ADMIN_TENANT_ID=90505c8a-23a9-4cdf-a26b-4e19f6a097d5
KC_OTP_RESEND_INTERVAL=60
KEYCLOAK_VOTER_GROUP_NAME=voter

# mTLS client certificate configuration.
#
# KC_SPI_TRUSTSTORE_PROVIDER — which truststore SPI to use:
#   "url"  load CA certs from a URL (our plugin, activated below)
#   "file" load CA certs from a local file (Keycloak built-in default)
# Replace the URL with an HTTPS endpoint or S3 pre-signed URL pointing to your
# CA certificate PEM.
#
# when --spi-truststore-provider is not passed, Keycloak defaults to file.
# But the file provider requires --spi-truststore-file-file to be explicitly set
# to a path. If that's not configured either, the file provider is effectively
# disabled and Keycloak falls back to the JVM's default TLS trust (cacerts) for
# outbound connections.
KC_SPI_TRUSTSTORE_PROVIDER=url
# URL of the global CA cert (optional). When it is not set, the JVM default.
# KC_SPI_TRUSTSTORE_URL_URL=

KC_SPI_TRUSTSTORE_URL_REFRESH_INTERVAL_SECONDS=60

# KC_SPI_X509CERT_LOOKUP_PROVIDER — how Keycloak extracts the client cert:
#   "default" reads cert directly from the TLS connection (no proxy needed).
#   "nginx"   reads cert from the ssl-client-cert HTTP header (nginx mTLS proxy).
#   "rfc9440" reads cert from the Client-Cert HTTP header (Cloudflare mTLS).
# Use "nginx" when keycloak-nginx terminates mTLS and forwards the cert header.
# Use "rfc9440" if Cloudflare terminates mTLS directly without a local nginx proxy.
KC_SPI_X509CERT_LOOKUP_PROVIDER=nginx

# SimpleSAMLphp
SSP_ADMIN_PASSWORD=password
SSP_LOG_LEVEL=info
SSP_LOG_HANDLER=errorlog
SSP_SECRET_SALT=
SSP_ENABLED_MODULES=
SSP_EXAMPLE_USERS=
TENANT_ID=90505c8a-23a9-4cdf-a26b-4e19f6a
EVENT_ID=
SP_IDP_ALIAS=
SP_CLIENT_ID=
SP_CERT_DATA=
APACHE_CERT_NAME=ssl-cert-snakeoil

# PostgreSQL
HASURA_PG_PASSWORD=postgrespassword
KEYCLOAK_DB__USER=postgres
KEYCLOAK_DB__PASSWORD=postgrespassword
KEYCLOAK_DB__HOST=postgres-keycloak
KEYCLOAK_DB__PORT=5432
KEYCLOAK_DB__DBNAME=keycloak
KEYCLOAK_DB__MANAGER__RECYCLING_METHOD=Verified
HASURA_DB__USER=postgres
HASURA_DB__PASSWORD=postgrespassword
HASURA_DB__HOST=postgres
HASURA_DB__PORT=5432
HASURA_DB__DBNAME=postgres
HASURA_DB__MANAGER__RECYCLING_METHOD=Verified

# Minio (AWS S3)
AWS_S3_ROOT_USER=minio
AWS_S3_ROOT_PASSWORD=minio123
AWS_S3_ACCESS_KEY=minio
AWS_S3_ACCESS_SECRET=minio123
AWS_S3_PRIVATE_URI=http://minio:9000
AWS_S3_BUCKET=sequent
AWS_S3_PUBLIC_BUCKET=public
PUBLIC_ASSETS_PATH="public-assets"
AWS_S3_UPLOAD_EXPIRATION_SECS=3600
AWS_S3_FETCH_EXPIRATION_SECS=3600
AWS_REGION=us-east-1
AWS_S3_MAX_UPLOAD_BYTES=5368709120
AWS_S3_JWKS_CACHE_POLICY=max-age=30
AWS_S3_JWKS_CERTS_PATH=certs.json

# Vault
VAULT_UNSEAL_KEY=
VAULT_TOKEN=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# Cloudflare
CLOUDFLARE_ZONE=
CLOUDFLARE_API_KEY=
CUSTOM_URLS_IP_DNS_CONTENT=

# Immudb
IMMUDB_USER=immudb
IMMUDB_PASSWORD=immudb
IMMUDB_LOGS_DB=defaultdb
IMMUDB_HOST=immudb
IMMUDB_PORT=3322
IMMUDB_INDEX_DB=indexdb
IMMUDB_BOARD_DB_NAME=board

# B3
B3_PG_HOST=postgres-b3
B3_PG_PORT=5432
B3_PG_USER=postgres
B3_PG_PASSWORD=postgrespassword
B3_PG_DATABASE=b3
B3_BIND=0.0.0.0:50051

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
AMQP_ADDR=amqp://guest:guest@rabbitmq:5672

# Secrets
# Note: SECRETS_BACKEND and MASTER_SECRET will be set by configure-environment.sh
# For manual setup: use EnvVarMasterSecret with a 32-byte hex string
SECRETS_BACKEND=EnvVarMasterSecret
MASTER_SECRET=
AWS_SM_KEY_PREFIX=

# Misc
MAX_DIFF_LINES=100
SECONDS_TO_SHOW_COUNTDOWN=60
SECONDS_TO_SHOW_ALRET=300
LOW_SQL_LIMIT=50000
DEFAULT_SQL_LIMIT=50000
DEFAULT_SQL_BATCH_SIZE=100000

# Trustee/Braid Configuration
TRUSTEE1_CONFIG=/opt/braid/trustee1.toml
TRUSTEE1_CONFIG_DATA=
TRUSTEE2_CONFIG=/opt/braid/trustee2.toml
TRUSTEE3_CONFIG=/opt/braid/trustee3.toml
IGNORE_BOARDS=

# Keycloak Realm Configuration
KEYCLOAK_ELECTION_EVENT_REALM_CONFIG_S3_KEY=defaults/keycloak/tenant-90505c8a-23a9-4cdf-a26b-4e19f6a097d5-event-33f18502-a67c-4853-8333-a58630663559.json
KEYCLOAK_TENANT_REALM_CONFIG_S3_KEY=defaults/keycloak/tenant-90505c8a-23a9-4cdf-a26b-4e19f6a097d5.json

# JWKS and Authentication
# Note: Using internal MinIO URL because Hasura container cannot reach public internet
HASURA_GRAPHQL_JWT_SECRET={"jwk_url": "http://minio-proxy:9002/public/certs.json"}
# Note: ACTIONS_ADMIN_SECRET is not set by configure-environment.sh (same as KEYCLOAK_ADMIN_CLIENT_SECRET)
ACTIONS_ADMIN_SECRET=admin
DEMO_PUBLIC_KEY=eh8l6lsmKSnzhMewrdLXEKGe9KVxxo//QsCT2wwAkBo

# Communication
# Replace both dummy placeholders: they are rejected as invalid transport names.
# Production: SMS uses AwsSns; email uses AwsSes or smtp (configure its credentials).
# Console is test-only and prints full messages, including secrets, into worker logs.
SMS_TRANSPORT_NAME=dummy
AWS_SNS_ATTRIBUTES={}
EMAIL_TRANSPORT_NAME=dummy
EMAIL_FROM=noreply@sequent.com

# Election Configuration
ELECTION_EVENT_FIXED_UUIDS=

# PDF/Document Rendering
DOC_RENDERER_BACKEND=inplace
REGISTRY=localhost:5000
OPENWHISK_DOC_RENDERER_ENDPOINT=http://127.0.0.2:3233/api/v1/namespaces/_/actions/pdf-tools/doc_renderer?blocking=true&result=true

# Build Configuration
RUSTFLAGS=-Awarnings
CARGO_TARGET_DIR=rust-local-target

# Loadero (Load Testing)
LOADERO_BASE_URL=
LOADERO_API_KEY=
LOADERO_INTERVAL_POLLING_TIME=30

# Health Probes
HARVEST_PROBE_ADDR=0.0.0.0:8001
HARVEST_PROBE_LIVE_PATH=live
HARVEST_PROBE_READY_PATH=ready
WINDMILL_PROBE_ADDR=0.0.0.0:8002
WINDMILL_PROBE_LIVE_PATH=live
WINDMILL_PROBE_READY_PATH=ready
BEAT_PROBE_ADDR=0.0.0.0:8003
BEAT_PROBE_LIVE_PATH=live
BEAT_PROBE_READY_PATH=ready
