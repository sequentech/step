{
  "modes": [
    {
      "name": "ui-only",
      "summary": "Storybook and screens on fixtures, with no backend service",
      "config": "ui-only/devcontainer.json",
      "composeFiles": ["docker-compose.yml"],
      "services": ["devcontainer"],
      "servers": [
        "storybook-ui-essentials",
        "storybook-voting-portal",
        "storybook-admin-portal",
        "storybook-results-portal",
        "storybook-ballot-verifier",
        "voting-portal",
        "ballot-verifier",
        "admin-portal",
        "results-portal"
      ],
      "defaultServers": ["storybook-ui-essentials"],
      "readyTimeoutSeconds": 300
    },
    {
      "name": "ui-keycloak",
      "summary": "Keycloak and its database for login and account theme work",
      "config": "ui-keycloak/devcontainer.json",
      "composeFiles": ["docker-compose.yml", "docker-compose-ui-keycloak.yml"],
      "services": [
        "devcontainer",
        "postgres-volume-init",
        "postgres-keycloak",
        "keycloak"
      ],
      "servers": [
        "storybook-ui-essentials",
        "storybook-voting-portal",
        "storybook-admin-portal",
        "storybook-results-portal",
        "storybook-ballot-verifier"
      ],
      "defaultServers": [],
      "readyTimeoutSeconds": 900
    },
    {
      "name": "backend",
      "summary": "Databases, queues, storage, Keycloak, Hasura and the Rust services",
      "config": "backend/devcontainer.json",
      "composeFiles": ["docker-compose.yml"],
      "services": [
        "devcontainer",
        "postgres-volume-init",
        "postgres",
        "postgres-keycloak",
        "postgres-b4",
        "minio",
        "minio-proxy",
        "configure-minio",
        "data-connector-agent",
        "graphql-engine",
        "rabbitmq",
        "immudb",
        "immudb-init",
        "keycloak",
        "keycloak-nginx",
        "harvest",
        "windmill",
        "beat",
        "b4"
      ],
      "servers": [],
      "defaultServers": [],
      "readyTimeoutSeconds": 3600
    },
    {
      "name": "full",
      "summary": "The backend plus the portal dev servers",
      "config": "devcontainer.json",
      "composeFiles": ["docker-compose.yml"],
      "services": [
        "devcontainer",
        "postgres-volume-init",
        "postgres",
        "postgres-keycloak",
        "postgres-b4",
        "minio",
        "minio-proxy",
        "configure-minio",
        "data-connector-agent",
        "graphql-engine",
        "rabbitmq",
        "immudb",
        "immudb-init",
        "keycloak",
        "keycloak-nginx",
        "harvest",
        "windmill",
        "beat",
        "b4"
      ],
      "servers": [
        "voting-portal",
        "ballot-verifier",
        "admin-portal",
        "results-portal",
        "storybook-ui-essentials",
        "storybook-voting-portal",
        "storybook-admin-portal",
        "storybook-results-portal",
        "storybook-ballot-verifier"
      ],
      "defaultServers": ["voting-portal", "admin-portal"],
      "readyTimeoutSeconds": 3600
    }
  ],
  "servers": [
    {
      "name": "storybook-ui-essentials",
      "port": 6006,
      "command": ["yarn", "--cwd", "packages/ui-essentials", "storybook"],
      "readyPath": "/index.json"
    },
    {
      "name": "storybook-voting-portal",
      "port": 6007,
      "command": ["yarn", "--cwd", "packages/voting-portal", "storybook"],
      "readyPath": "/index.json"
    },
    {
      "name": "storybook-admin-portal",
      "port": 6008,
      "command": ["yarn", "--cwd", "packages/admin-portal", "storybook"],
      "readyPath": "/index.json"
    },
    {
      "name": "storybook-results-portal",
      "port": 6009,
      "command": ["yarn", "--cwd", "packages/results-portal", "storybook"],
      "readyPath": "/index.json"
    },
    {
      "name": "storybook-ballot-verifier",
      "port": 6010,
      "command": ["yarn", "--cwd", "packages/ballot-verifier", "storybook"],
      "readyPath": "/index.json"
    },
    {
      "name": "voting-portal",
      "port": 3000,
      "command": ["yarn", "--cwd", "packages/voting-portal", "start"],
      "readyPath": "/"
    },
    {
      "name": "ballot-verifier",
      "port": 3001,
      "command": ["yarn", "--cwd", "packages/ballot-verifier", "start"],
      "readyPath": "/"
    },
    {
      "name": "admin-portal",
      "port": 3002,
      "command": ["yarn", "--cwd", "packages/admin-portal", "start"],
      "readyPath": "/"
    },
    {
      "name": "results-portal",
      "port": 3004,
      "command": ["yarn", "--cwd", "packages/results-portal", "start"],
      "readyPath": "/"
    }
  ],
  "services": [
    {
      "name": "postgres-volume-init",
      "readyWhen": "exited"
    },
    {
      "name": "configure-minio",
      "readyWhen": "exited"
    },
    {
      "name": "immudb-init",
      "readyWhen": "exited"
    },
    {
      "name": "keycloak",
      "url": "http://127.0.0.1:8090",
      "probe": [
        "bash",
        "-c",
        "exec 3<>/dev/tcp/127.0.0.1/8090 && printf 'GET /realms/master HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n' >&3 && head -n 1 <&3 | grep -q ' 200 '"
      ]
    },
    {
      "name": "graphql-engine",
      "url": "http://127.0.0.1:8080",
      "probe": ["curl", "-fsS", "-o", "/dev/null", "http://127.0.0.1:8080/healthz"]
    },
    {
      "name": "minio",
      "url": "http://127.0.0.1:9001"
    },
    {
      "name": "immudb",
      "url": "http://127.0.0.1:3325"
    },
    {
      "name": "rabbitmq",
      "url": "http://127.0.0.1:15672"
    },
    {
      "name": "windmill",
      "probe": ["curl", "-fsS", "-o", "/dev/null", "http://127.0.0.1:3030/ready"]
    },
    {
      "name": "b4",
      "probe": ["curl", "-fsS", "-o", "/dev/null", "http://127.0.0.1:50051/boards"]
    }
  ]
}
