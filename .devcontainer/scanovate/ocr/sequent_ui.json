        "font_weight": "normal",
        "padding": "0 5px",
        "border_radius": "5px"
      },
      "loading_screen_hint": {
        "color": "#5b6e7b",
        "background_color": "transparent",
        "font_family": "Roboto-Regular, Roboto, Arial, sans-serif",
