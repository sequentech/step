{
  "title": {
    "color": "#ffffff",
    "background_color": "transparent",
    "font_family": "Roboto, \"Segoe UI\", system-ui, -apple-system, sans-serif",
    "font_size": "22px",
    "font_weight": "bold",
    "padding": "0 5px",
    "border_radius": "5px"
  },
  "instruction": {
    "color": "#173449",
    "background_color": "#ffffff",
    "font_family": "Roboto, \"Segoe UI\", system-ui, -apple-system, sans-serif",
    "font_size": "18px",
    "font_weight": "bold",
    "padding": "8px 16px",
    "border_radius": "999px"
  },
  "frame": {
    "overlay_background": {
      "background_color": "rgb(11,34,49)",
      "background_opacity": "0.72"
    },
    "border_radius": 20,
    "color": "#ffffff",
    "width": 3,
    "segment_color": "#43e3a1"
  },
  "close_button": {
    "size": "44px",
    "color": "#ffffff",
    "visible": true
  },
  "loading_screen": {
    "background_color": "#ffffff",
    "shield_color": "#0d796a",
    "shield_icon": {
      "asset": "data:image/svg+xml;base64,",
      "width_percentage": 40,
      "visible": true
    },
    "spinner_color": "#0d796a",
    "spinner_size_percentage": 80,
    "spinner_visible": true,
    "direction": "auto",
    "loading_screen_title": {
      "color": "#173449",
      "background_color": "transparent",
      "font_family": "Roboto, \"Segoe UI\", system-ui, -apple-system, sans-serif",
      "font_size": "24px",
      "font_weight": "bold",
      "padding": "0 5px",
      "border_radius": "5px"
    },
    "loading_screen_subtitle": {
      "color": "#5b6e7b",
      "background_color": "transparent",
      "font_family": "Roboto, \"Segoe UI\", system-ui, -apple-system, sans-serif",
      "font_size": "18px",
      "font_weight": "normal",
      "padding": "0 5px",
      "border_radius": "5px"
    },
    "loading_screen_hint": {
      "color": "#5b6e7b",
      "background_color": "transparent",
      "font_family": "Roboto, \"Segoe UI\", system-ui, -apple-system, sans-serif",
      "font_size": "15px",
      "font_weight": "normal",
      "padding": "0 5px",
      "border_radius": "5px"
    }
  },
  "success_indicator": {
    "checkmark_color": "#0d796a"
  }
}
