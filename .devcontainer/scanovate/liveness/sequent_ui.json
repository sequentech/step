{
  "title": {
    "color": "white",
    "background_color": "transparent",
    "font_family": "Roboto-Bold, Roboto, Arial, sans-serif",
    "font_size": "25px",
    "font_weight": "bold",
    "padding": "0 5px",
    "border_radius": "5px"
  },
  "instruction": {
    "color": "white",
    "background_color": "rgba(13,121,106,0.85)",
    "font_family": "Roboto-Regular, Roboto, Arial, sans-serif",
    "font_size": "25px",
    "font_weight": "normal",
    "padding": "0 5px",
    "border_radius": "5px"
  },
  "frame": {
    "overlay_background": {
      "background_color": "rgb(0,0,0)",
      "background_opacity": "0.7"
    },
    "border_radius": 20,
    "color": "white",
    "width": 3,
    "segment_color": "#43e3a1"
  },
  "close_button": {
    "size": "60px",
    "color": "white",
    "visible": true
  },
  "loading_screen": {
    "background_color": "#FFFFFF",
    "shield_color": "#0d796a",
    "shield_icon": {
      "asset": "data:image/svg+xml;base64,",
      "width_percentage": 40,
      "visible": true
    },
    "spinner_color": "#0d796a",
    "spinner_size_percentage": 80,
    "spinner_visible": true,
    "direction": "auto",
    "loading_screen_title": {
      "color": "#173449",
      "background_color": "transparent",
      "font_family": "Roboto-Bold, Roboto, Arial, sans-serif",
      "font_size": "27px",
      "font_weight": "bold",
      "padding": "0 5px",
      "border_radius": "5px"
    },
    "loading_screen_subtitle": {
      "color": "#5b6e7b",
      "background_color": "transparent",
      "font_family": "Roboto-Regular, Roboto, Arial, sans-serif",
      "font_size": "23px",
      "font_weight": "normal",
      "padding": "0 5px",
      "border_radius": "5px"
    },
    "loading_screen_hint": {
      "color": "#5b6e7b",
      "background_color": "transparent",
      "font_family": "Roboto-Regular, Roboto, Arial, sans-serif",
      "font_size": "16px",
      "font_weight": "normal",
      "padding": "0 5px",
      "border_radius": "5px"
    }
  },
  "success_indicator": {
    "checkmark_color": "#43e3a1"
  }
