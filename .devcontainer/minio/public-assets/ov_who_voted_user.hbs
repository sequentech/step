  SPDX-License-Identifier: AGPL-3.0-only

  List of voters who actually voted. One page per area of each Post, after a
  summary of the Posts listed. It names who voted, never when or how: there
  is no ballot time, channel or choice in its data.

  It names voters, so it is rendered with scripts disabled: no script-drawn QR
  code (2025 drew one with the report hash, system hash, version, time and
  user, which are printed below as text).
--}}
<div class="report">
  <table align="center" style="width: 100%">
    <tr>
      <td align="left">
        <p class="date_printed">
          {{datetime_zone execution_annotations.date_printed output_format="%B %d, %Y %H:%M"}}
        </p>
      </td>
    </tr>
    <tr class="main-title">
      <td align="center">
        <p><strong>LIST OF VOTERS WHO ACTUALLY VOTED</strong></p>
        <p>
          {{#eq scope "all_posts"}}All Posts{{else}}One Post{{/eq}}
          &middot; Voters who voted: {{voted_total}}
          {{#if batch}}
          &middot; Part {{batch.number}} of {{batch.total}} (rows {{batch.first_row}} to {{batch.last_row}})
          {{/if}}
        </p>
      </td>
    </tr>
    <tr>
      <td>
        <table class="table-section">
          <thead>
            <tr>
              <td><strong>Post</strong></td>
              <td><strong>Election</strong></td>
              <td><strong>Areas</strong></td>
              <td><strong>Voters who voted</strong></td>
            </tr>
          </thead>
          <tbody>
            {{#each posts}}
            <tr>
              <td>{{post}}</td>
              <td>{{election_title}}</td>
              <td>{{areas}}</td>
              <td>{{voted}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </td>
    </tr>
  </table>
</div>

{{#each areas}}
<div class="report">
  <table align="center" style="width: 100%">
    <tr>
      <td>
        <table class="main-header">
          <tr>
            <td class="center">
              <div class="election-name">{{election_title}}</div>
              <div class="country">Post: {{post}}</div>
              <div class="online">Area: {{#if area_id}}{{area_name}}{{else}}(not in an area of this Post){{/if}}</div>
              <div class="voting-period">
                Voting Period:
                {{#if election_dates.scheduled_event_dates.START_VOTING_PERIOD.scheduled_at}}{{datetime_zone election_dates.scheduled_event_dates.START_VOTING_PERIOD.scheduled_at output_format="%d %B %Y"}}{{else}}{{#if election_dates.first_started_at}}{{datetime_zone election_dates.first_started_at output_format="%d %B %Y"}}{{else}}-{{/if}}{{/if}}
                -
                {{#if election_dates.scheduled_event_dates.END_VOTING_PERIOD.scheduled_at}}{{datetime_zone election_dates.scheduled_event_dates.END_VOTING_PERIOD.scheduled_at output_format="%d %B %Y"}}{{else}}{{#if election_dates.last_stopped_at}}{{datetime_zone election_dates.last_stopped_at output_format="%d %B %Y"}}{{else}}-{{/if}}{{/if}}
              </div>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <tr class="main-title">
      <td align="center">
        <p><strong>LIST OF VOTERS WHO ACTUALLY VOTED</strong></p>
        {{#if voters}}
        {{#eq first 1}}{{else}}<p>Continued: rows {{first}} to {{last}} of {{voted}}</p>{{/eq}}
        {{/if}}
      </td>
    </tr>

    <tr>
      <td>
        {{#if voters}}
        <table class="table-section">
          <thead>
            <tr>
              <td><strong>No.</strong></td>
              <td><strong>Name</strong></td>
              <td><strong>Voter ID</strong></td>
            </tr>
          </thead>
          <tbody>
            {{#each voters}}
            <tr>
              <td>{{number}}</td>
              <td>
                {{#if record_missing}}(voter record not found){{else}}{{last_name}}, {{first_name}} {{suffix}} {{middle_name}}{{/if}}
              </td>
              <td>{{username}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{else}}
        <p style="text-align: center">No voter of this area has voted.</p>
        {{/if}}
      </td>
    </tr>

    <tr>
      <td>
        <table class="stats-table">
          <tr>
            <td class="key"><strong>No. of voters who voted:</strong></td>
            <td class="value">{{voted}}</td>
          </tr>
          <tr>
            <td class="key"><strong>No. of voters who did not vote:</strong></td>
            <td class="value">{{not_voted}}</td>
          </tr>
          <tr>
            <td class="key"><strong>Total No. of voters:</strong></td>
            <td class="value">{{total}}</td>
          </tr>
        </table>
      </td>
    </tr>

    <tr class="sys-info">
      <td align="center">
        <div>
          Report hash: {{../execution_annotations.report_hash}}<br />
          {{#if ../execution_annotations.configuration_revision}}
          Configuration revision {{../execution_annotations.configuration_revision}}, manifest SHA-256 {{../execution_annotations.configuration_manifest_sha256}}<br />
          {{/if}}
          {{#if ../execution_annotations.copy_total}}
          Copy {{../execution_annotations.copy_number}} of {{../execution_annotations.copy_total}}<br />
          {{/if}}
          Software version: {{../execution_annotations.software_version}}<br />
          System hash: {{../execution_annotations.app_hash}}<br />
          Generated by: {{../execution_annotations.executer_username}}
        </div>
      </td>
    </tr>

    <tr class="report-end">
      <td align="center">
        <p>End of Report</p>
        <hr />
      </td>
    </tr>
  </table>
</div>
{{/each}}
