<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Voter Information Letter</title>
  <style>
    @page { size: A4; margin: 0; }
    * { box-sizing: border-box; margin: 0; }
    body {
      font-family: "Times New Roman", Times, Georgia, serif;
      color: #1a1a1a;
      background: #fff;
    }
    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 18mm 0 22mm;
      background: #fff;
    }
    .header-block {
      padding: 0 18mm 9mm;
      border-bottom: 2px solid #0F054C;
      margin-bottom: 9mm;
    }
    .main-header {
      width: 100%;
      border-collapse: collapse;
    }
    .main-header .left {
      width: 23%;
      vertical-align: top;
      text-align: left;
    }
    .main-header .center {
      width: 54%;
      text-align: center;
      vertical-align: top;
    }
    .main-header .right { width: 23%; }
    .sequent-logo {
      display: block;
      width: 42mm;
      height: auto;
    }
    .event-name {
      font-size: 10pt;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #444;
      margin-bottom: 2mm;
    }
    .election-title {
      font-size: 18pt;
      font-weight: 700;
      color: #0F054C;
      margin-bottom: 2.5mm;
    }
    .doc-type {
      font-size: 10pt;
      font-weight: 700;
      letter-spacing: .12em;
      color: #333;
    }
    .issued {
      margin-top: 3mm;
      font-size: 9pt;
      color: #555;
    }
    .confidential {
      text-align: center;
      font-size: 10pt;
      font-weight: 700;
      margin-bottom: 7mm;
      color: #0F054C;
    }
    .body-copy {
      padding: 0 19mm 6mm;
      font-size: 11pt;
      line-height: 1.6;
    }
    .body-copy p + p { margin-top: 4mm; }
    .credentials {
      margin: 3mm 19mm 9mm;
      width: calc(100% - 38mm);
      border-collapse: collapse;
      font-size: 10.5pt;
    }
    .credentials th,
    .credentials td {
      border: 1px solid #c5c9d0;
      padding: 3mm 4mm;
      text-align: left;
      overflow-wrap: anywhere;
    }
    .credentials th {
      background: #f4f6fa;
      font-weight: 600;
      width: 36%;
    }
    .mono { font-family: ui-monospace, "Courier New", monospace; }
    .credentials a { color: #0F054C; }
    .footer-copy {
      padding: 0 19mm;
      font-size: 10pt;
      line-height: 1.55;
      color: #444;
    }
  </style>
</head>
<body>
  <main class="page">
    {{{rendered_user_template}}}
  </main>
</body>
</html>
