<header class="header-block">
  <table class="main-header" role="presentation">
    <tr>
      <td class="left">
        <img class="sequent-logo" src="{{logo_url}}" alt="Sequent">
      </td>
      <td class="center">
        <div class="event-name">ELECTION EVENT</div>
        <h1 class="election-title">{{election_event_name}}</h1>
        <div class="doc-type">VOTER INFORMATION LETTER</div>
        <p class="issued">Issued: {{issue_date}}</p>
      </td>
      <td class="right"></td>
    </tr>
  </table>
</header>

<p class="confidential">Confidential — For the addressee only</p>

<div class="body-copy">
  <p>Dear {{voter_full_name}},</p>
  <p>
    You are registered to participate in the election identified above.
    This letter contains the credentials you will need to access the voting
    system. Please store it securely and do not share it with anyone.
  </p>
</div>

<table class="credentials">
  <thead>
    <tr>
      <th scope="col">Field</th>
      <th scope="col">Value</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>Username</td>
      <td>{{username}}</td>
    </tr>
    <tr>
      <td>Password</td>
      <td class="mono">{{password}}</td>
    </tr>
    <tr>
      <td>Voting portal</td>
      <td><a href="{{voting_portal_url}}">{{voting_portal_url}}</a></td>
    </tr>
  </tbody>
</table>

<div class="footer-copy">
  <p>Sincerely,<br>Sequent</p>
</div>
