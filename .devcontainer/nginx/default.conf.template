# Keycloak
server {
    listen 80;
    server_name login-remote-deployment.${DOMAIN};

    location / {
        proxy_pass http://keycloak:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "for=$remote_addr;host=$host;proto=https";

        # Client certificates reach Keycloak only through the mTLS proxy
        # (keycloak-nginx), which sets ssl-client-cert itself.
        proxy_set_header ssl-client-cert "";
        proxy_set_header Cf-Tls-Client-Cert "";
        proxy_set_header Client-Cert "";

        # Increase buffer sizes for large headers from Keycloak
        proxy_buffer_size 32k;
        proxy_buffers 4 16k;
        proxy_busy_buffers_size 32k;
    }
}

