# .env.remote-test.example
# This is an example .env file for a remote test environment using a reverse proxy.
# Copy this to .env and fill in the values.

################################################################################
# Docker Compose Configuration
COMPOSE_PROFILES=full
COMPOSE_PROJECT_NAME=step_remote_test

################################################################################
# General
ENV_SLUG=remote-test
APP_VERSION=0.0.1
APP_HASH=dev

# --- NEW: Reverse Proxy Domain Configuration ---
# The root domain managed by Cloudflare.
DOMAIN=sequent.vote

# Logging
LOG_LEVEL=info
RUST_BACKTRACE=1
CARGO_TERM_COLOR=always
HASURA_GRAPHQL_ENABLED_LOG_TYPES=startup, http-log, webhook-log, websocket-log, query-log

# Ports
# Note: These ports are for internal container communication.
# Public access will be managed by the Nginx reverse proxy on ports 80/443.
HARVEST_PORT=8000
MOCK_SERVER_PORT=8082
KC_HTTP_PORT=8090
ADMIN_PORTAL_PORT=3002
VOTING_PORTAL_PORT=3000
HASURA_PORT=8080
MINIO_PORT=9002

# URLs and Hostnames
KC_HOSTNAME=login-remote-test.${DOMAIN}
KC_HOSTNAME_STRICT=false
KEYCLOAK_URL=https://${KC_HOSTNAME}
KEYCLOAK_PUBLIC_URL=https://${KC_HOSTNAME}
HARVEST_DOMAIN=remote-test.${DOMAIN}
HASURA_ENDPOINT=https://hasura-remote-test.${DOMAIN}/v1/graphql
VOTING_PORTAL_URL=https://voting-remote-test.${DOMAIN}
ADMIN_PORTAL_URL=https://admin-remote-test.${DOMAIN}
VOTING_PORTAL_HOSTNAME=voting-remote-test.${DOMAIN}
ADMIN_PORTAL_HOSTNAME=admin-remote-test.${DOMAIN}
IDP_BASE_URL=http://simplesamlphp:8083/simplesaml
SP_BASE_URL=https://${KC_HOSTNAME}
IMMUDB_SERVER_URL=http://immudb:3322
VAULT_SERVER_URL=http://vault:8200
B3_URL=http://b3:50051
BALLOT_VERIFIER_URL=https://voting-remote-test.${DOMAIN}
AWS_S3_PUBLIC_URI=https://minio-remote-test.${DOMAIN}
ROCKET_ADDRESS=0.0.0.0

# Hasura
HASURA_PG_PASSWORD=postgrespassword
HASURA_PG_USER=postgres
HASURA_PG_PORT=5432
HASURA_PG_DBNAME=postgres
HASURA_PG_HOST=postgres
HASURA_GRAPHQL_METADATA_DATABASE_URL=postgres://${HASURA_PG_USER}:${HASURA_PG_PASSWORD}@${HASURA_PG_HOST}:${HASURA_PG_PORT}/${HASURA_PG_DBNAME}
HASURA_PG_DATABASE_URL=postgres://${HASURA_PG_USER}:${HASURA_PG_PASSWORD}@${HASURA_PG_HOST}:${HASURA_PG_PORT}/${HASURA_PG_DBNAME}
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_DEV_MODE=true
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=unauthorized
HASURA_GRAPHQL_MIGRATIONS_DIR=/workspaces/step/hasura/migrations
HASURA_GRAPHQL_METADATA_DIR=/workspaces/step/hasura/metadata
HASURA_GRAPHQL_CONSOLE_ASSETS_DIR=/srv/console-assets
HASURA_GRAPHQL_METADATA_DEFAULTS={"backend_configs":{"dataconnector":{"athena":{"uri":"http://data-connector-agent:8081/api/v1/athena"},"mariadb":{"uri":"http://data-connector-agent:8081/api/v1/mariadb"},"mysql8":{"uri":"http://data-connector-agent:8081/api/v1/mysql"},"oracle":{"uri":"http://data-connector-agent:8081/api/v1/oracle"},"snowflake":{"uri":"http://data-connector-agent:8081/api/v1/snowflake"}}}}
HASURA_GRAPHQL_MIGRATIONS_SERVER_TIMEOUT=60

# Keycloak
KC_DB=postgres
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=postgrespassword
KC_DB_SCHEMA=public
KC_DB_URL_HOST=postgres-keycloak
KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_ID=sequent
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_CLI_CLIENT_ID=admin-portal
KEYCLOAK_CLI_CLIENT_SECRET=
SUPER_ADMIN_TENANT_ID=
KC_OTP_RESEND_INTERVAL=60
KEYCLOAK_VOTER_GROUP_NAME=voter

# SimpleSAMLphp
SSP_ADMIN_PASSWORD=password
SSP_LOG_LEVEL=info
SSP_LOG_HANDLER=errorlog
SSP_SECRET_SALT=
SSP_ENABLED_MODULES=
SSP_EXAMPLE_USERS=
TENANT_ID=
EVENT_ID=
SP_IDP_ALIAS=
SP_CLIENT_ID=
SP_CERT_DATA=
APACHE_CERT_NAME=ssl-cert-snakeoil

# PostgreSQL
HASURA_PG_PASSWORD=postgrespassword
KEYCLOAK_DB__USER=postgres
KEYCLOAK_DB__PASSWORD=postgrespassword
KEYCLOAK_DB__HOST=postgres-keycloak
KEYCLOAK_DB__PORT=5432
KEYCLOAK_DB__DBNAME=keycloak
KEYCLOAK_DB__MANAGER__RECYCLING_METHOD=fast
HASURA_DB__USER=postgres
HASURA_DB__PASSWORD=postgrespassword
HASURA_DB__HOST=postgres
HASURA_DB__PORT=5432
HASURA_DB__DBNAME=postgres
HASURA_DB__MANAGER__RECYCLING_METHOD=fast

# Minio (AWS S3)
AWS_S3_ROOT_USER=minio
AWS_S3_ROOT_PASSWORD=minio123
AWS_S3_ACCESS_KEY=minio
AWS_S3_ACCESS_SECRET=minio123
AWS_S3_PRIVATE_URI=http://minio:9000
AWS_S3_BUCKET=sequent
AWS_S3_PUBLIC_BUCKET=sequent-public
PUBLIC_ASSETS_PATH=/workspaces/step/.devcontainer/minio/public-assets
AWS_S3_UPLOAD_EXPIRATION_SECS=3600
AWS_S3_FETCH_EXPIRATION_SECS=3600
AWS_REGION=us-east-1
AWS_S3_MAX_UPLOAD_BYTES=10485760
AWS_S3_JWKS_CACHE_POLICY=max-age=30
AWS_S3_JWKS_CERTS_PATH=certs.json

# Vault
VAULT_UNSEAL_KEY=
VAULT_TOKEN=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# Cloudflare
CLOUDFLARE_ZONE=
CLOUDFLARE_API_KEY=
CUSTOM_URLS_IP_DNS_CONTENT=

# Immudb
IMMUDB_USER=immudb
IMMUDB_PASSWORD=immudb
IMMUDB_LOGS_DB=defaultdb
IMMUDB_HOST=immudb
IMMUDB_PORT=3322
IMMUDB_INDEX_DB=indexdb
IMMUDB_BOARD_DB_NAME=board

# B3
B3_PG_HOST=postgres-b3
B3_PG_PORT=5432
B3_PG_USER=postgres
B3_PG_PASSWORD=postgrespassword
B3_PG_DATABASE=b3
B3_BIND=0.0.0.0:50051

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
AMQP_ADDR=amqp://guest:guest@rabbitmq:5672

# Secrets
SECRETS_BACKEND=vault
MASTER_SECRET=
AWS_SM_KEY_PREFIX=

# Misc
MAX_DIFF_LINES=100
SECONDS_TO_SHOW_COUNTDOWN=300
SECONDS_TO_SHOW_ALRET=60
LOW_SQL_LIMIT=10
DEFAULT_SQL_LIMIT=100
DEFAULT_SQL_BATCH_SIZE=100

# Trustee/Braid Configuration
TRUSTEE1_CONFIG=/opt/braid/trustee1.toml
TRUSTEE1_CONFIG_DATA=
TRUSTEE2_CONFIG=/opt/braid/trustee2.toml
TRUSTEE3_CONFIG=/opt/braid/trustee3.toml
IGNORE_BOARDS=

# Keycloak Realm Configuration
KEYCLOAK_ELECTION_EVENT_REALM_CONFIG_PATH=/import/realm.json
KEYCLOAK_TENANT_REALM_CONFIG_PATH=/import/tenant.json

# JWKS and Authentication
HASURA_GRAPHQL_JWT_SECRET={"jwk_url": "${AWS_S3_PUBLIC_URI}/public/certs.json"}
ACTIONS_ADMIN_SECRET=
DEMO_PUBLIC_KEY=

# Communication
SMS_TRANSPORT_NAME=dummy
AWS_SNS_ATTRIBUTES={}
EMAIL_TRANSPORT_NAME=dummy
EMAIL_FROM=noreply@sequent.com

# Election Configuration
ELECTION_EVENT_FIXED_UUIDS=

# PDF/Document Rendering
DOC_RENDERER_BACKEND=openwhisk
REGISTRY=localhost:5000
OPENWHISK_DOC_RENDERER_ENDPOINT=http://127.0.0.2:3233/api/v1/namespaces/_/actions/pdf-tools/doc_renderer?blocking=true&result=true

# Build Configuration
RUSTFLAGS=-Awarnings
CARGO_TARGET_DIR=rust-local-target

# Loadero (Load Testing)
LOADERO_BASE_URL=
LOADERO_API_KEY=
LOADERO_INTERVAL_POLLING_TIME=30

# Health Probes
HARVEST_PROBE_ADDR=0.0.0.0:8001
HARVEST_PROBE_LIVE_PATH=/live
HARVEST_PROBE_READY_PATH=/ready
WINDMILL_PROBE_ADDR=0.0.0.0:8002
WINDMILL_PROBE_LIVE_PATH=/live
WINDMILL_PROBE_READY_PATH=/ready
BEAT_PROBE_ADDR=0.0.0.0:8003
BEAT_PROBE_LIVE_PATH=/live
BEAT_PROBE_READY_PATH=/ready
