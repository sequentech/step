# Terminates TLS and optionally mTLS in front of Keycloak (dev).
# Passes the client certificate (if any) to Keycloak via the
# ssl-client-cert header, which is read by the nginx x509cert lookup
# provider (KC_SPI_X509CERT_LOOKUP_PROVIDER=nginx).
#
# - ssl_verify_client optional: cert is never forced; voters without a cert
#   fall through to password auth in Keycloak as normal.
# - Large proxy buffers: client certs in headers can be ~2 KB URL-encoded.

log_format mtls '$remote_addr - ssl_verify=$ssl_client_verify cert_len=$ssl_client_escaped_cert';

server {
    listen 8443 ssl;
    server_name localhost 127.0.0.1;

    ssl_certificate     /etc/nginx/certs/nginx-tls.crt;
    ssl_certificate_key /etc/nginx/certs/nginx-tls.key;

    ssl_client_certificate /etc/nginx/client-ca/client-ca.pem;
    ssl_verify_client      optional;
    ssl_verify_depth       2;

    proxy_buffer_size   16k;
    proxy_buffers       4 16k;
    proxy_busy_buffers_size 16k;

    # Re-resolve keycloak hostname on each request so stale IPs after
    # container restarts don't cause 502s. 127.0.0.11 is Docker's internal DNS.
    resolver 127.0.0.11 valid=10s;

    access_log /dev/stdout mtls;

    # Redirect Keycloak-proxied 400s (e.g. X.509 auth rejection) to the
    # voting portal error page. Must be in the server block so
    # proxy_intercept_errors in the location block can trigger it.
    error_page 400 =302 ${VOTING_PORTAL_URL}/cert-auth-error;

    location / {
        set $keycloak_upstream http://keycloak:8090;
        proxy_pass $keycloak_upstream;

        # Intercept Keycloak-proxied 400s so the server-block error_page above
        # can redirect them. proxy_buffering on is required with variable-based
        # proxy_pass, otherwise proxy_intercept_errors has no effect.
        proxy_buffering on;
        proxy_intercept_errors on;

        proxy_set_header Host               $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  https;
        proxy_set_header X-Forwarded-Host   $host;
        proxy_set_header X-Forwarded-Port   8443;

        # Client certificate forwarded to Keycloak (URL-encoded PEM).
        # Empty string when no cert is presented — Keycloak treats that as
        # "no cert" and falls through to the next authenticator.
        proxy_set_header ssl-client-cert    $ssl_client_escaped_cert;
        # Verification status ("SUCCESS", "FAILED:…", or "NONE").
        # Required by Keycloak's nginx x509cert lookup when
        # trust-proxy-verification=true.
        proxy_set_header ssl-client-verify  $ssl_client_verify;
    }
}
