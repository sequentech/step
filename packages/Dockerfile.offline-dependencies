# Vendors everything the product images fetch -- Cargo crates, Yarn packages,
# Maven repositories, the oid4vp source archive and the immudb binaries -- into
# one image, so those images can then be built with no network access at all.
#
# This exists for the offline/airgapped release pipeline (sequentech/meta#13625),
# where dependencies are fetched on an online machine and the product is built on
# a physically separate disconnected one.
#
# SCOPE, precisely: this covers dependency resolution -- Cargo crates, Yarn
# packages, Maven repositories, the oid4vp archive and the immudb binaries. It
# does NOT yet make the images fully buildable with --network=none, because the
# runtime stages still install operating-system packages and download tools:
#
#   Dockerfile.prod            apk add jq                      (nginx:alpine)
#   Dockerfile.immudb          apk add ca-certificates bash    (runtime stage)
#   harvest, windmill          apt-get install ...; a JDK from download.java.net;
#                              cargo-binstall from raw.githubusercontent.com
#   b4, braid                  apt-get install ...; the AWS CLI; Vault
#
# Closing that needs OS package archives and pinned tool downloads vendored as
# well, which is a larger change and a separate piece of work. Until then this
# image removes the dependency-resolution network traffic, which is the bulk of
# it and the part that varies per commit.
#
# Note also that b4 and braid resolve VAULT_VERSION by scraping
# releases.hashicorp.com at build time when it is "latest". That is a floating
# version decided during the build, so two builds of the same commit can ship
# different Vault binaries -- a reproducibility problem independent of offline
# builds, and one that has to be pinned before any byte-comparison gate can pass.
#
# Build (online):
#   docker build -t sequentech.local/offline-dependencies:latest \
#     -f packages/Dockerfile.offline-dependencies packages
#
# Then build any product image with its dependencies resolved from this image
# rather than from a registry:
#   docker build --build-arg VENDOR_IMAGE=sequentech.local/offline-dependencies:latest \
#     -f packages/harvest/Dockerfile.prod packages
#
# --network=none does not work yet; see the scope note above for what is missing.
#
# The toolchain versions here must match the ones the product Dockerfiles build
# with, or the vendored artifacts will not be the ones the build wants.

# Global build arguments. These must precede the first FROM: an ARG after a FROM
# belongs to that stage only, and a later stage redeclaring it would then see an
# empty value -- which silently turned a pinned immudb tag into an empty one.
# Debian archive snapshot every apt call resolves against. Pinning the archive
# state, rather than individual package versions, is what makes the dependency
# closure identical on a client's machine and on ours: pinning only the packages
# we name leaves their dependencies to whatever the live mirror serves that day
# (installing wget with its version pinned still resolves libpsl5 from the
# mirror). See sequentech/meta#13625.
#
# http, not https: these base images ship no CA certificates, so an https source
# fails before anything is installed. apt verifies the signed InRelease and the
# per-file checksums regardless of transport.
#
# Bumping this is a deliberate release action, like bumping a base image digest:
# it changes what the build contains, so it produces a new release identity. A
# pinned snapshot also stops picking up security updates until it is bumped.
ARG DEBIAN_SNAPSHOT=20260929T000000Z

ARG IMMUDB_VERSION=1.9.6
ARG OID4VP_VERSION=0.6.2
ARG OID4VP_SHA256=f6cd968bc77fec4f8e1417d3caeefe4920941e01b119f152f1c9186bbd2b2e15

# Cargo dependencies, including git dependencies and patched crates, which
# cargo vendor resolves into the same directory.
FROM rust:1.96.0-slim-bookworm@sha256:4732ca96fd086cb9be682050c3f0176288eebaac2b80aa2bcefccfaf198e1950 AS rust-deps
# Resolve apt against the pinned snapshot rather than the live mirror.
ARG DEBIAN_SNAPSHOT
RUN set -eux; \
    rm -f /etc/apt/sources.list.d/debian.sources; \
    { \
      echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm main"; \
      echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm-updates main"; \
      echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT} bookworm-security main"; \
    } > /etc/apt/sources.list

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
# The emitted config.toml names an absolute directory. Consumers rewrite that
# path rather than depending on this layout, because a COPY from an image can
# only reliably start at its root.
# The redirect target cannot live inside /vendor-cache: the shell creates it
# before cargo has made that directory. Write it outside, then move it in.
RUN cargo vendor /vendor-cache > /config.toml \
    && mv /config.toml /vendor-cache/config.toml

# Yarn dependencies as an offline mirror: a directory of tarballs that
# `yarn install --offline` resolves against without contacting a registry.
FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0 AS node-deps
WORKDIR /workspace
COPY . .
RUN printf 'yarn-offline-mirror "/npm-packages-offline-cache"\nyarn-offline-mirror-pruning false\n' > .yarnrc \
    && yarn install --frozen-lockfile --non-interactive

# immudb is third-party upstream code, fetched and compiled here rather than
# vendored as source. Building it needs git, a C toolchain and the Go module
# proxy, and none of that can be reconstructed offline from a source tree alone.
# The binaries it produces are therefore an accepted prebuilt upstream input, in
# the sense meta#13625 uses: they are not Sequent product code, and the release
# manifest records them as upstream rather than as something the offline build
# compiled.
#
# Built for BUILDPLATFORM, matching what Dockerfile.immudb's builder stage does.
FROM --platform=$BUILDPLATFORM golang:1.22-alpine@sha256:1699c10032ca2582ec89a24a1312d986a3f094aed3d5c1147b19880afe40e052 AS immudb-build
ARG IMMUDB_VERSION
RUN apk add --no-cache git make gcc musl-dev bash
WORKDIR /src
RUN git clone --depth 1 --branch "v${IMMUDB_VERSION}" https://github.com/codenotary/immudb.git .
RUN make immudb immuadmin

# Maven dependencies for the Keycloak provider extensions.
#
# The whole build is run here with a local repository so that everything it
# reaches for -- dependencies, plugins and their transitive closure -- ends up in
# that repository. dependency:go-offline is not enough: it resolves declared
# dependencies but misses plugins pulled in during the lifecycle, and the offline
# build then fails on something that was never downloaded.
FROM maven:3-amazoncorretto-17@sha256:046784a9c83821fc3e9ded94c2f18155e0daf1981c8a0813d0ff693a9dc4a51b AS keycloak-m2
COPY ./keycloak-extensions/ /build/packages/keycloak-extensions/
WORKDIR /build
RUN mvn -B -Dmaven.repo.local=/m2-repo \
        -f packages/keycloak-extensions/pom.xml clean package \
    && find /build -name target -type d -prune -exec rm -rf {} +

# The oid4vp extension's source archive and its Maven closure. The tarball is
# checksum-pinned upstream, so vendoring it changes nothing about what is trusted.
FROM maven:3-amazoncorretto-21@sha256:efdf660ec74911594e2a7f642e177ffba21b741c8e848223bf41a6d0fc367692 AS oid4vp-m2
ARG OID4VP_VERSION
ARG OID4VP_SHA256
RUN curl -fsSL -o /tmp/oid4vp.tar.gz \
    https://github.com/ba-itsys/keycloak-extension-oid4vp/archive/refs/tags/v${OID4VP_VERSION}.tar.gz \
 && echo "${OID4VP_SHA256}  /tmp/oid4vp.tar.gz" | sha256sum -c - \
 && mkdir -p /oid4vp && cp /tmp/oid4vp.tar.gz /oid4vp/oid4vp.tar.gz \
 && mkdir -p /build && tar -xzf /tmp/oid4vp.tar.gz -C /build \
 && cd /build/keycloak-extension-oid4vp-${OID4VP_VERSION} \
 && mvn -B -Dmaven.repo.local=/m2-repo clean package -DskipTests

# Both caches at the image root, and nothing else. Consumers copy from / so the
# same COPY works whether or not this image was supplied -- the default is
# scratch, which yields an empty directory and an unchanged online build.
FROM scratch
COPY --from=rust-deps /vendor-cache /vendor-cache
COPY --from=node-deps /npm-packages-offline-cache /npm-packages-offline-cache
COPY --from=immudb-build /src/immudb /immudb-bin/immudb
COPY --from=immudb-build /src/immuadmin /immudb-bin/immuadmin
COPY --from=keycloak-m2 /m2-repo /m2-repo
COPY --from=oid4vp-m2 /m2-repo /m2-repo-oid4vp
COPY --from=oid4vp-m2 /oid4vp /oid4vp
