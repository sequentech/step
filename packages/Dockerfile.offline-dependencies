# Vendors everything the product images fetch -- Cargo crates, Yarn packages,
# Maven repositories, the oid4vp source archive and the immudb binaries -- into
# one image, so those images can then be built with no network access at all.
#
# This exists for the offline/airgapped release pipeline (sequentech/meta#13625),
# where dependencies are fetched on an online machine and the product is built on
# a physically separate disconnected one. It is the only image here that needs the
# network; everything downstream consumes its output.
#
# Build (online):
#   docker build -t sequentech.local/offline-dependencies:latest \
#     -f packages/Dockerfile.offline-dependencies packages
#
# Then build any product image with no network:
#   docker build --build-arg VENDOR_IMAGE=sequentech.local/offline-dependencies:latest \
#     --network=none -f packages/harvest/Dockerfile.prod packages
#
# The toolchain versions here must match the ones the product Dockerfiles build
# with, or the vendored artifacts will not be the ones the build wants.

# Cargo dependencies, including git dependencies and patched crates, which
# cargo vendor resolves into the same directory.
FROM rust:1.96.0-slim-bookworm AS rust-deps
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
# The emitted config.toml names an absolute directory. Consumers rewrite that
# path rather than depending on this layout, because a COPY from an image can
# only reliably start at its root.
RUN cargo vendor /vendor-cache > /vendor-cache/config.toml

# Yarn dependencies as an offline mirror: a directory of tarballs that
# `yarn install --offline` resolves against without contacting a registry.
FROM node:20-bookworm-slim AS node-deps
WORKDIR /workspace
COPY . .
RUN printf 'yarn-offline-mirror "/npm-packages-offline-cache"\nyarn-offline-mirror-pruning false\n' > .yarnrc \
    && yarn install --frozen-lockfile --non-interactive

# immudb is third-party upstream code, fetched and compiled here rather than
# vendored as source. Building it needs git, a C toolchain and the Go module
# proxy, and none of that can be reconstructed offline from a source tree alone.
# The binaries it produces are therefore an accepted prebuilt upstream input, in
# the sense meta#13625 uses: they are not Sequent product code, and the release
# manifest records them as upstream rather than as something the offline build
# compiled.
#
# Built for BUILDPLATFORM, matching what Dockerfile.immudb's builder stage does.
ARG IMMUDB_VERSION=1.9.6
FROM --platform=$BUILDPLATFORM golang:1.22-alpine AS immudb-build
ARG IMMUDB_VERSION
RUN apk add --no-cache git make gcc musl-dev bash
WORKDIR /src
RUN git clone --depth 1 --branch "v${IMMUDB_VERSION}" https://github.com/codenotary/immudb.git .
RUN make immudb immuadmin

# Maven dependencies for the Keycloak provider extensions.
#
# The whole build is run here with a local repository so that everything it
# reaches for -- dependencies, plugins and their transitive closure -- ends up in
# that repository. dependency:go-offline is not enough: it resolves declared
# dependencies but misses plugins pulled in during the lifecycle, and the offline
# build then fails on something that was never downloaded.
FROM maven:3-amazoncorretto-17 AS keycloak-m2
COPY ./keycloak-extensions/ /build/packages/keycloak-extensions/
WORKDIR /build
RUN mvn -B -Dmaven.repo.local=/m2-repo \
        -f packages/keycloak-extensions/pom.xml clean package \
    && find /build -name target -type d -prune -exec rm -rf {} +

# The oid4vp extension's source archive and its Maven closure. The tarball is
# checksum-pinned upstream, so vendoring it changes nothing about what is trusted.
ARG OID4VP_VERSION=0.6.2
ARG OID4VP_SHA256=f6cd968bc77fec4f8e1417d3caeefe4920941e01b119f152f1c9186bbd2b2e15
FROM maven:3-amazoncorretto-21 AS oid4vp-m2
ARG OID4VP_VERSION
ARG OID4VP_SHA256
RUN curl -fsSL -o /tmp/oid4vp.tar.gz \
    https://github.com/ba-itsys/keycloak-extension-oid4vp/archive/refs/tags/v${OID4VP_VERSION}.tar.gz \
 && echo "${OID4VP_SHA256}  /tmp/oid4vp.tar.gz" | sha256sum -c - \
 && mkdir -p /oid4vp && cp /tmp/oid4vp.tar.gz /oid4vp/oid4vp.tar.gz \
 && mkdir -p /build && tar -xzf /tmp/oid4vp.tar.gz -C /build \
 && cd /build/keycloak-extension-oid4vp-${OID4VP_VERSION} \
 && mvn -B -Dmaven.repo.local=/m2-repo clean package -DskipTests

# Both caches at the image root, and nothing else. Consumers copy from / so the
# same COPY works whether or not this image was supplied -- the default is
# scratch, which yields an empty directory and an unchanged online build.
FROM scratch
COPY --from=rust-deps /vendor-cache /vendor-cache
COPY --from=node-deps /npm-packages-offline-cache /npm-packages-offline-cache
COPY --from=immudb-build /src/immudb /immudb-bin/immudb
COPY --from=immudb-build /src/immuadmin /immudb-bin/immuadmin
COPY --from=keycloak-m2 /m2-repo /m2-repo
COPY --from=oid4vp-m2 /m2-repo /m2-repo-oid4vp
COPY --from=oid4vp-m2 /oid4vp /oid4vp
