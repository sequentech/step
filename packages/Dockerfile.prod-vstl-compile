# Dockerfile
ARG SPA_NAME
FROM ${SPA_NAME}-dependencies
WORKDIR /usr/src/app/

COPY ui-core ui-core
COPY ui-essentials ui-essentials
COPY voting-portal voting-portal
COPY admin-portal admin-portal
COPY ballot-verifier ballot-verifier
COPY results-portal results-portal

# Production typechecking includes log tests that import this shared fixture.
COPY keycloak-extensions/custom-event-listener/src/test/resources/scanovate-failure-contract.json \
     keycloak-extensions/custom-event-listener/src/test/resources/scanovate-failure-contract.json.license \
     keycloak-extensions/custom-event-listener/src/test/resources/

ARG SPA_NAME

RUN yarn build:ui-core
RUN yarn build:ui-essentials
RUN yarn build:${SPA_NAME}
