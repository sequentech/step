# Optional offline dependency source. The default, scratch, copies an empty
# directory into the builder and leaves the online build byte-identical. Point it
# at packages/Dockerfile.offline-dependencies' output to build with no network:
#   --build-arg VENDOR_IMAGE=sequentech.local/offline-dependencies:latest --network=none
# See sequentech/meta#13625.
ARG VENDOR_IMAGE=scratch
FROM ${VENDOR_IMAGE} AS vendor

FROM node:20-alpine as builder
WORKDIR /usr/src/app/


#copy only necessary files, exclude source code from the runtime image
COPY ./ui-core ./ui-core
COPY ./ui-essentials ./ui-essentials
COPY ./voting-portal ./voting-portal
COPY ./admin-portal ./admin-portal
COPY ./ballot-verifier ./ballot-verifier
COPY ./results-portal ./results-portal
COPY ./package.json ./package.json
COPY ./yarn.lock ./yarn.lock

# Install dependencies. With a vendor image supplied, resolve them from its
# offline mirror instead of the registry; otherwise fetch as before.
COPY --from=vendor / /vendor/
RUN if [ -d /vendor/npm-packages-offline-cache ]; then \
        printf 'yarn-offline-mirror "/vendor/npm-packages-offline-cache"\nyarn-offline-mirror-pruning false\n' > .yarnrc && \
        echo "offline build: using vendored packages from /vendor/npm-packages-offline-cache" && \
        yarn install --frozen-lockfile --offline --non-interactive; \
    else \
        yarn install --frozen-lockfile --non-interactive; \
    fi

ARG SPA_NAME

# Build the specified SPA with release optimizations
RUN yarn build:ui-core
RUN yarn build:ui-essentials
RUN yarn build:${SPA_NAME}



FROM nginx:alpine
# Install dependencies
RUN apk add --no-cache jq
# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*
# Copy custom NGINX config
COPY default.conf /etc/nginx/conf.d/
ARG SPA_NAME
# Copy the built SPA from the 'dist' directory of the build stage to the Nginx server
COPY --from=builder /usr/src/app/${SPA_NAME}/dist /usr/share/nginx/html
COPY nginx-entrypoint.sh entrypoint.sh
RUN chmod +x entrypoint.sh
# Expose port 80 for the Nginx server
EXPOSE 80
# NOTE: The entrypoint script will replace the global-settings.json values with the environment variables
#       ALL THE global-settings.json KEYS ARE AVAILABLE AS ENVIRONMENT VARIABLES
# Replace global-setting.json values & Start Nginx in the foreground
ENTRYPOINT [ "/entrypoint.sh" ]
