# Single source of configuration for the Python load-test scripts in
# packages/step-cli/scripts/ — none of them take command-line arguments,
# every knob lives here. Paths below are relative to the scripts/ directory
# itself (where setup_telephone_load_test.py etc. live), unless absolute. See
# docs/docusaurus/docs/07-developers/12-ivr/telephone-load-testing-design.md
# and docs/docusaurus/docs/07-developers/02-cli/02-tutorials/load-testing/online-load-testing-design.md
# for the full designs, and the guide next to each for a walkthrough.
#
# This is the tracked template. Once you've filled in your own credentials,
# move (don't copy) it into the gitignored config/ folder next to this file:
#     mkdir -p telephone-load-test-inputs/config
#     cp telephone-load-test-inputs/layers.yaml.example telephone-load-test-inputs/config/layers.yaml
# The scripts read config/layers.yaml specifically — real credentials for a
# given target server belong there, never in this tracked template.
#
# Every field below is tagged "Optional" or "Mandatory":
#   - Optional fields have a sensible default that works everywhere (or are
#     situational and simply don't need to be set for most runs).
#   - Mandatory fields are deployment-specific — masked here as `****`
#     (never a real secret) rather than left blank, so a diff shows at a
#     glance which ones need a real value for a given target server. `****`
#     is treated the same as `null`: it falls back to the environment
#     variable named in the comment, then dies with a clear error if that's
#     also unset. Every one of those env vars is already exported in this
#     repo's devcontainer, so copying this file to config/layers.yaml
#     unedited and running it there works out of the box — no field needs
#     editing until you point these scripts at a server other than the
#     devcontainer stack.

# --- Stage 1: setup_telephone_load_test.py -------------------------------
#
# Provisions an election event for a tenant, bulk-creates DTMF-safe voters,
# runs the keys ceremony, publishes, and opens the requested voting channel.
# Writes a summary.json + voters CSV under out_dir that Stage 2 consumes —
# run_telephone_load_test.py (driving `ivr-cli` calls) for TELEPHONE,
# run_online_load_test.py (driving Playwright browsers) for ONLINE.
setup:
  election_event_json: telephone-load-test-inputs/election-event.json  # Optional, defaults to the tracked example election event

  # TELEPHONE or ONLINE — which voting channel to open at the end. Switch
  # this (and the matching out_dir below) before running
  # run_online_load_test.py instead of run_telephone_load_test.py.
  voting_channel: TELEPHONE  # Optional, defaults to TELEPHONE

  # Recorded in summary.json for Stage 2 ONLINE; for a distributed run, set
  # this to the publicly reachable URL.
  voting_portal_url: http://localhost:3000  # Optional, only used by Stage 2 ONLINE — irrelevant for TELEPHONE runs

  # Identity used to log in and, when new_tenants > 0, to create the new
  # tenants — see new_tenants below for whether it's ALSO one of the tenants
  # that receives the election event.
  tenant_id: "****"  # Mandatory, defaults to $SUPER_ADMIN_TENANT_ID

  # How many brand-new tenants to create and provision the SAME election
  # event into (each gets its own independent import/voters/ceremony/publish
  # — see run_telephone_load_test.py, which then places calls across all of
  # them). 0 = provision tenant_id itself, unchanged. null (the default)
  # resolves to 0 if tenant_id is set above, or 1 if it's left "****"/unset
  # (replicating the old "no tenant_id -> creates a new tenant" behavior).
  # Set explicitly to provision N new tenants regardless of whether
  # tenant_id is given.
  new_tenants: null  # Optional, defaults to 0 if tenant_id is set, else 1

  num_voters: 20  # Optional, defaults to 20
  voter_pin_digits: 6  # Optional, numeric PIN length (max 8, the DTMF limit), defaults to 6

  # First voter username (usernames increment from here), so every username
  # is at least 3 digits.
  voter_username_start: 100  # Optional, defaults to 100

  # Every generated voter is placed in this single area, so all voters get
  # the same contest count and one DTMF template works for every call.
  voter_area_name: null  # Optional, defaults to the 1st area in the election event JSON

  threshold: 2  # Optional, key ceremony trustee threshold, defaults to 2

  # AUTOMATIC or MANUAL — see the comment on trustee1_password below.
  # AUTOMATIC needs the target tenant's registered trustees to have live
  # braid services (true in the devcontainer).
  ceremony_policy: AUTOMATIC  # Optional, defaults to AUTOMATIC

  endpoint_url: "****"  # Mandatory, Hasura GraphQL endpoint, defaults to $HASURA_ENDPOINT
  keycloak_url: "****"  # Mandatory, defaults to $KEYCLOAK_URL

  # Tenant-realm login: a user holding the admin-user role inside this
  # tenant's own realm — the same identity that logs into the Admin Portal
  # to manage this tenant. Used for every election-management step (import,
  # publish, open voting).
  admin_portal_user: "****"  # Mandatory, defaults to $ADMIN_PORTAL_TEST_USERNAME
  admin_portal_password: "****"  # Mandatory, defaults to $ADMIN_PORTAL_TEST_PASSWORD

  # Keycloak platform/master-realm admin — only read when new_tenants > 0,
  # to look up each freshly created tenant's api-key-client secret (a new
  # tenant's realm gets its own, randomly regenerated one; there's no way to
  # know it ahead of time). NOT the same identity as admin_portal_user
  # above, which is scoped to one tenant's own realm.
  keycloak_admin_user: "****"  # Mandatory (if new_tenants > 0), defaults to $KEYCLOAK_ADMIN
  keycloak_admin_password: "****"  # Mandatory (if new_tenants > 0), defaults to $KEYCLOAK_ADMIN_PASSWORD

  # Needs "gold" acr for publish/voting-status; the devcontainer's
  # $KEYCLOAK_CLI_CLIENT_ID is a lower tier and will 403 on those two steps.
  keycloak_client_id: api-key-client  # Optional, fixed client id — do not change

  # Found via Keycloak admin console -> this tenant's realm -> Clients ->
  # api-key-client -> Credentials.
  keycloak_client_secret: "****"  # Mandatory, defaults to $API_KEY_CLIENT_SECRET

  # Only read when ceremony_policy is MANUAL — an AUTOMATIC ceremony never
  # logs in as either trustee.
  trustee1_user: trustee1  # Optional, defaults to "trustee1"
  trustee1_password: "****"  # Mandatory (if ceremony_policy: MANUAL), defaults to $TRUSTEE1_PASSWORD
  trustee2_user: trustee2  # Optional, defaults to "trustee2"
  trustee2_password: "****"  # Mandatory (if ceremony_policy: MANUAL), defaults to $TRUSTEE2_PASSWORD

  # Where summary.json + the voters CSV land. Keep in sync with
  # telephone_run.run_dir / online_run.run_dir below (whichever matches
  # voting_channel).
  out_dir: telephone-load-test-output/run  # Optional, defaults to telephone-load-test-output/run

# --- Stage 2 (TELEPHONE): run_telephone_load_test.py ----------------------
#
# Takes Stage 1's outputs, generates a local phone_config.json and one DTMF
# input script per voter from a captured call template, then fans out N
# parallel `ivr-cli --bundle dev` processes — each an independent simulated
# phone call against the dev container's real Keycloak/Hasura. Only used when
# setup.voting_channel is TELEPHONE.
telephone_run:
  run_dir: telephone-load-test-output/run  # Optional, must match setup.out_dir

  # DTMF input template with {{PIN}} and whichever of {{VOTER_ID}}/{{DOB}}
  # this realm's auth flow uses. Capture a new one with one manual ivr-cli
  # call — see dtmf-template.example.txt for the procedure — if you change
  # setup.election_event_json or setup.voter_area_name.
  dtmf_template: dtmf-template.example.txt  # Optional, defaults to the tracked example template

  concurrency: 10  # Optional, defaults to 10
  max_calls: null  # Optional, null = every voter in the CSV

  # Skip the first N voters in the CSV before placing calls. For distributed
  # runs: give each load machine a disjoint slice of one Stage-1 voter set
  # via voter_offset/max_calls, so no two machines re-use (and duplicate-vote)
  # the same voters.
  voter_offset: 0  # Optional, defaults to 0

  # Override summary.json's keycloak_url/hasura_url — needed when Stage 1 was
  # provisioned with URLs (e.g. the devcontainer's 127.0.0.1) that this
  # machine cannot reach.
  keycloak_url: null  # Optional, defaults to summary.json's keycloak_url
  hasura_url: null  # Optional, defaults to summary.json's hasura_url

  # Client secrets for the ivr-service/ivr-voting Keycloak clients — these
  # live in the ELECTION EVENT's own realm (summary.json's keycloak_realm),
  # created fresh by every Stage 1 run, NOT the tenant realm alongside
  # api-key-client. Re-fetch after each Stage 1 run (Keycloak admin console
  # -> that realm -> Clients -> ivr-service/ivr-voting -> Credentials) — a
  # value from a previous run's election event will not work for a new one.
  # .devcontainer/.env.development's defaults only match the local
  # devcontainer's one seeded test election event. Used as the fallback for
  # any tenant not listed in tenant_ivr_secrets below — with only one
  # tenant (setup.new_tenants: 0, the default) these two are all you need.
  keycloak_ivr_service_client_secret: "****"  # Mandatory (unless every tenant is in tenant_ivr_secrets), defaults to $KEYCLOAK_IVR_SERVICE_CLIENT_SECRET
  keycloak_ivr_voting_client_secret: "****"  # Mandatory (unless every tenant is in tenant_ivr_secrets), defaults to $KEYCLOAK_IVR_VOTING_CLIENT_SECRET

  # Per-tenant overrides for a multi-tenant run (setup.new_tenants > 1) —
  # each tenant's election event gets its own, different ivr-service/
  # ivr-voting secrets, so the flat defaults above can cover at most one of
  # them. Keyed by tenant_id; example:
  #   tenant_ivr_secrets:
  #     8dcd2cf1-79e2-4f19-8eb9-570a728039df:
  #       keycloak_ivr_service_client_secret: ...
  #       keycloak_ivr_voting_client_secret: ...
  tenant_ivr_secrets: {}  # Optional, defaults to {} (every tenant uses the flat secrets above)

  call_timeout: 300  # Optional, per-call timeout in seconds, defaults to 300
  system_number: "+111111111111"  # Optional, number the simulated callers dial

  # null = ivr-cli on PATH, else beyond/packages/{rust-local-target,target}/release/ivr-cli
  ivr_cli_bin: null  # Optional, auto-detected if unset

  valkey_url: null  # Optional, session store URL, defaults to $VALKEY_URL, else auto-detected/started
  start_valkey: true  # Optional, docker-run a local valkey if no session store is reachable

  # Per-call log regex counted as a cast ballot (the receipt prompt).
  success_regex: "ballot locator"  # Optional, defaults to "ballot locator"

  out_dir: telephone-load-test-output/calls  # Optional, defaults to telephone-load-test-output/calls

# --- Stage 2 (ONLINE): run_online_load_test.py -----------------------------
#
# Renders a voter manifest, then drives one Playwright run in
# packages/voting-portal where each voter is a real headless-browser session
# going through login, election selection, candidate selection, review, cast
# and confirmation. Only used when setup.voting_channel is ONLINE.
online_run:
  run_dir: online-load-test-output/run  # Optional, must match setup.out_dir

  # Parallel voting clients (Playwright workers). Each is a real Chromium
  # page doing WASM ballot encryption — budget roughly 0.5GB RAM and one core
  # per client, on top of the compose stack.
  concurrency: 4  # Optional, defaults to 4

  max_votes: null  # Optional, null = every voter in the CSV
  voter_offset: 0  # Optional, see telephone_run.voter_offset for the distributed-run reason
  vote_timeout: 180  # Optional, per-voter end-to-end timeout in seconds, defaults to 180

  # Override summary.json's voting_portal_url/keycloak_url/hasura_url —
  # needed when Stage 1 recorded URLs this machine cannot reach.
  voting_portal_url: null  # Optional, defaults to summary.json's voting_portal_url
  keycloak_url: null  # Optional, defaults to summary.json's keycloak_url
  hasura_url: null  # Optional, defaults to summary.json's hasura_url

  # Regular expression filtering which candidates may be selected, by visible
  # name. null = deterministic first-eligible-candidates selection.
  candidates_pattern: null  # Optional, null = deterministic first-eligible-candidate selection

  headed: false  # Optional, run browsers headed for debugging; forces concurrency to 1

  out_dir: online-load-test-output/votes  # Optional, defaults to online-load-test-output/votes
