# https://www.keycloak.org/server/containers#_installing_additional_rpm_packages

# Start with a Maven base image to compile the 2FA authenticator
FROM quay.io/keycloak/keycloak:24.0.5@sha256:f8ade94c1d0ad2f2fa7734a455fee5392764f402c43ca35e9af6bf63a2541dc9
COPY --from=keycloak-compile /opt/keycloak/ /opt/keycloak/
COPY ./keycloak-extensions/quarkus.properties /opt/keycloak/conf/quarkus.properties

ENV KC_DB=postgres
# Java4Shell (CVE-2026-114938) mitigation: disable the JDK Base64 intrinsic,
# whose x86-64 AVX-512 VBMI decode path has an out-of-bounds heap write. No
# fixed Red Hat JDK / Keycloak image exists yet. kc.sh appends JAVA_OPTS_APPEND
# to its default JAVA_OPTS (it does not replace them). The flag is accepted on
# arm64 too, it just has no effect there. A deployment that sets its own
# JAVA_OPTS_APPEND overrides this, so it must include the flag as well.
ENV JAVA_OPTS_APPEND="-XX:-UseBASE64Intrinsics"
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]