# https://quay.io/repository/keycloak/keycloak?tab=tags
#
# To add more software to the image, take a look at
# https://www.keycloak.org/server/containers#_installing_additional_rpm_packages

# Start with a Maven base image to compile the 2FA authenticator
FROM quay.io/keycloak/keycloak:26.6.4
COPY --from=keycloak-compile /opt/keycloak/ /opt/keycloak/
COPY ./keycloak-extensions/quarkus.properties /opt/keycloak/conf/quarkus.properties

ENV KC_DB=postgres
# Java4Shell (CVE-2026-114938): disable the vulnerable AVX-512 Base64 decode
# intrinsic until the Keycloak image ships a fixed JDK. kc.sh appends
# JAVA_OPTS_APPEND after its defaults; arm64 JVMs accept the flag too.
# https://github.com/sequentech/meta/issues/15038
ENV JAVA_OPTS_APPEND="-XX:-UseBASE64Intrinsics"
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]