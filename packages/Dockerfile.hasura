# Sequent Hasura runtime: official cli-migrations image + this commit's
# hasura/migrations and hasura/metadata. On start the upstream entrypoint
# (docker-entrypoint.sh) applies metadata then migrations, then serves.
#
# Build context must be the repo-root `hasura/` directory (CI matrix
# `context: hasura`), so COPY paths below are relative to that dir — not
# repo root (avoid `context: .`).
#
# PG source backend-db comes from metadata databases.yaml:
#   database_url.from_env: PG_DATABASE_URL
# Action handlers use {{HARVEST_DOMAIN}} resolved by the engine from env
# (set HARVEST_DOMAIN=harvest:8400 on the pod — no sed at apply time).
#
# Pin matches gitops hasura engine version.
ARG HASURA_VERSION=v2.33.1
# Digest of hasura/graphql-engine:v2.33.1.cli-migrations-v3, so the base cannot
# change under a tag that upstream rebuilds. This is the multi-arch index digest,
# so amd64 and arm64 both still resolve. Update it together with HASURA_VERSION.
ARG HASURA_DIGEST=sha256:02577c5e456726cbe1888e377d21c464979ed888636047adf3aae678d9ab70e6
FROM hasura/graphql-engine:${HASURA_VERSION}.cli-migrations-v3@${HASURA_DIGEST}

# Upstream image includes user/group hasura (UID/GID 1001). Prefer non-root
# for the long-running server (Hasura container security guidance).
# cli-migrations entrypoint stages under /tmp and uses /.hasura — ensure
# those paths are writable by hasura before dropping privileges.
COPY --chown=hasura:hasura migrations /hasura-migrations
COPY --chown=hasura:hasura metadata /hasura-metadata
RUN mkdir -p /.hasura /tmp/hasura-project \
    && chown -R hasura:hasura /.hasura /tmp \
    && chmod -R g=u /.hasura /tmp
USER hasura
