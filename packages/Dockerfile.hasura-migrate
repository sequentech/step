# Hasura migrate+metadata image: ships step/hasura migrations & metadata and the Hasura CLI.
# Runtime env (required):
#   HASURA_GRAPHQL_ENDPOINT      e.g. http://hasura:8080
#   HASURA_GRAPHQL_ADMIN_SECRET  Hasura admin secret
# Optional:
#   HARVEST_DOMAIN              default harvest:8400 (in-cluster harvest service)
#   HASURA_DATABASE_NAME        default backend-db
#   ENSURE_PG_SOURCE            default true — pg_add_source if missing (first deploy)
#   PG_DATABASE_URL_ENV         default PG_DATABASE_URL — Hasura env var name for DB URL
#   WAIT_TIMEOUT_SECONDS        default 300

FROM alpine:3.20

RUN apk add --no-cache \
      bash \
      ca-certificates \
      curl \
      jq \
      sed \
    && curl -fsSL https://github.com/hasura/graphql-engine/raw/stable/cli/get.sh | VERSION=v2.36.0 bash \
    && hasura version \
    && adduser -D -u 10001 hasura

WORKDIR /hasura

# Migration pack from this step commit (same tag as other app images)
COPY hasura/config.yaml ./config.yaml
COPY hasura/migrations ./migrations
COPY hasura/metadata ./metadata

COPY packages/hasura-migrate/docker-entrypoint.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh \
    && chown -R hasura:hasura /hasura /entrypoint.sh

USER hasura

ENV HASURA_GRAPHQL_ENDPOINT=http://hasura:8080 \
    HARVEST_DOMAIN=harvest:8400 \
    HASURA_DATABASE_NAME=backend-db \
    ENSURE_PG_SOURCE=true \
    PG_DATABASE_URL_ENV=PG_DATABASE_URL \
    WAIT_TIMEOUT_SECONDS=300

ENTRYPOINT ["/entrypoint.sh"]
