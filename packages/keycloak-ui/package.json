{
    "private": true,
    "name": "@sequentech/keycloak-ui",
    "version": "0.1.0",
    "license": "AGPL-3.0-only",
    "description": "Opt-in Keycloak login and message OTP development workspace",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "build": "tsc --noEmit && vite build",
        "build-keycloak-theme": "yarn build && keycloakify build",
        "storybook": "storybook dev --port 6011 --no-open",
        "build-storybook": "storybook build",
        "test": "vitest run --project=storybook",
        "test:stories": "vitest run --project=storybook",
        "test:story": "node ../test-support/storybook/test-story.mjs",
        "test:real": "playwright test",
        "lint": "eslint .",
        "prettify": "prettier --check . --ignore-path .prettierignore",
        "prestorybook": "keycloakify copy-keycloak-resources-to-public",
        "prebuild-storybook": "keycloakify copy-keycloak-resources-to-public",
        "pretest": "keycloakify copy-keycloak-resources-to-public",
        "pretest:stories": "keycloakify copy-keycloak-resources-to-public",
        "pretest:story": "keycloakify copy-keycloak-resources-to-public",
        "test:hot": "KEYCLOAK_UI_HMR_SAMPLES=10 playwright test --grep \"automatic reload\""
    },
    "dependencies": {
        "keycloakify": "11.16.0",
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.1",
        "@mui/material": "7.3.2",
        "@sequentech/ui-essentials": "*",
        "react": "19.1.1",
        "react-dom": "19.1.1"
    },
    "devDependencies": {
        "@playwright/test": "1.62.1",
        "@sequentech/ui-test-kit": "*",
        "@storybook/addon-a11y": "10.6.0",
        "@storybook/addon-docs": "10.6.0",
        "@storybook/addon-vitest": "10.6.0",
        "@storybook/react-vite": "10.6.0",
        "@vitejs/plugin-react": "^5.1.0",
        "@vitest/browser-playwright": "4.1.11",
        "storybook": "10.6.0",
        "vitest": "4.1.11",
        "vite": "^7.3.5",
        "typescript": "^5.9.2",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "@types/node": "^24.3.3",
        "eslint": "^9.39.1",
        "prettier": "^3.6.2"
    }
}
