###############################################################################
# 1. ── BUILD STAGE ────────────────────────────────────────────────────────────
#    • Uses the same Go tool-chain immudb’s official Dockerfile relies on
#    • Compiles immudb / immuadmin for *TARGETPLATFORM* automatically
###############################################################################
# Optional offline dependency source. The default, scratch, copies an empty
# directory and leaves the online build unchanged. Point it at
# packages/Dockerfile.offline-dependencies' output to take the immudb binaries it
# compiled instead of cloning and building here.
#
# The runtime stage below still runs apk, so this alone is not enough for
# --network=none. See the scope note in Dockerfile.offline-dependencies.
# See sequentech/meta#13625.
# Global build arguments. These must precede the first FROM: an ARG after a FROM
# belongs to that stage only, and a later stage redeclaring it would then see an
# empty value.
ARG IMMUDB_VERSION=1.9.6
ARG VENDOR_IMAGE=scratch

FROM ${VENDOR_IMAGE} AS vendor

FROM --platform=$BUILDPLATFORM golang:1.22-alpine@sha256:1699c10032ca2582ec89a24a1312d986a3f094aed3d5c1147b19880afe40e052 AS builder

# redeclare it so that the stage can use it
ARG IMMUDB_VERSION

WORKDIR /src
COPY --from=vendor / /vendor/

# With a vendor image, take the binaries it already compiled. Otherwise clone and
# build as before.
#
# immudb is third-party upstream code, and building it needs git, a C toolchain
# and the Go module proxy -- none of which can be reconstructed offline from a
# source tree. So the vendor image compiles it while online and ships the
# binaries, which the release manifest records as an accepted prebuilt upstream
# input rather than as something the offline build produced.
RUN if [ -f /vendor/immudb-bin/immudb ]; then \
        echo "offline build: using prebuilt immudb binaries from the vendor image" && \
        cp /vendor/immudb-bin/immudb /vendor/immudb-bin/immuadmin /src/ && \
        chmod +x /src/immudb /src/immuadmin; \
    else \
        apk add --no-cache git=2.47.3-r0 make=4.4.1-r2 gcc=14.2.0-r4 \
            musl-dev=1.2.5-r11 bash=5.2.37-r0 && \
        git clone --depth 1 --branch "v${IMMUDB_VERSION}" https://github.com/codenotary/immudb.git . && \
        make immudb immuadmin; \
    fi

###############################################################################
# 2. ── RUNTIME STAGE (same as before, but copy from builder) ─────────────────
###############################################################################
FROM --platform=$TARGETPLATFORM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

# Minimal runtime deps, pinned to exact versions so the same build inputs resolve
# on a client's machine as on ours and the image hashes match (meta#13625).
#
# Alpine has no snapshot archive, so exact versions are the only lever; when one
# is superseded the build fails loudly and the pin is bumped, which is a new
# release identity rather than a silent change. Versions are per base image --
# this stage is alpine:3.24, the builder above is Alpine 3.21 via golang:1.22.
RUN apk add --no-cache ca-certificates=20260909-r0 bash=5.3.9-r1

# copy freshly-built, arch-correct binaries
COPY --from=builder /src/immudb /usr/sbin/immudb
COPY --from=builder /src/immuadmin /usr/local/bin/immuadmin
COPY --from=builder "/etc/ssl/certs/ca-certificates.crt" "/etc/ssl/certs/ca-certificates.crt"

# Copy necessary binaries and libraries from the Alpine base image
# No need to copy individual binaries like /bin/ls, /bin/bash, etc., as they are already part of the Alpine base image

# Setup environment variables as per original immudb Dockerfile
ENV IMMUDB_HOME="/usr/share/immudb" \
    IMMUDB_DIR="/var/lib/immudb" \
    IMMUDB_ADDRESS="0.0.0.0" \
    IMMUDB_PORT="3322" \
    IMMUDB_PIDFILE="" \
    IMMUDB_LOGFILE="" \
    IMMUDB_MTLS="false" \
    IMMUDB_AUTH="true" \
    IMMUDB_DETACHED="false" \
    IMMUDB_DEVMODE="true" \
    IMMUDB_MAINTENANCE="false" \
    IMMUDB_ADMIN_PASSWORD="immudb" \
    IMMUDB_PGSQL_SERVER="true" \
    IMMUADMIN_TOKENFILE="/var/lib/immudb/admin_token" \
    USER=immu \
    HOME="${IMMUDB_HOME}"

# Expose necessary ports
EXPOSE 3322 9497 8080 5432

# Define healthcheck to ensure container is healthy
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 CMD [ "/usr/local/bin/immuadmin", "status" ]

# Set user context
USER "${IMMU_UID}:${IMMU_GID}"

# Define the entrypoint for running immudb
ENTRYPOINT ["/usr/sbin/immudb"]