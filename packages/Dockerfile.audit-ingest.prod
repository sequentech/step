FROM rust:1.96.0-slim-bookworm@sha256:4732ca96fd086cb9be682050c3f0176288eebaac2b80aa2bcefccfaf198e1950 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake libssl-dev pkg-config protobuf-compiler && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN cargo build --release --locked -p electoral-log --bin bb_helper --bin audit_ingest
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/bb_helper /app/target/release/audit_ingest /usr/bin/
ENTRYPOINT ["/usr/bin/audit_ingest"]
