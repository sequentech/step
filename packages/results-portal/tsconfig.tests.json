{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "types": [
      "node",
      "jest"
    ],
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@sequentech/ui-core": [
        "../ui-core/src/index.tsx"
      ],
      "@sequentech/ui-essentials": [
        "../ui-essentials/src/index.tsx"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "playwright.journeys.config.ts",
    "../ui-essentials/src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
