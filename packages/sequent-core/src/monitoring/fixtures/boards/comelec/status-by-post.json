{
  "charts": {
    "posts": {
      "conditional_formatting": {
        "state_label": {
          "when": [
            {
              "background": "positive.bg",
              "eq": "Opened"
            },
            {
              "background": "warning.bg",
              "eq": "Paused"
            },
            {
              "background": "dbt-grays.muted",
              "eq": "Closed"
            }
          ]
        }
      },
      "query": "data",
      "style": {
        "columns": {
          "position": {
            "visible": false
          },
          "post": {
            "label": "Post"
          },
          "post_id": {
            "visible": false
          },
          "posts": {
            "visible": false
          },
          "region": {
            "label": "Region"
          },
          "state": {
            "visible": false
          },
          "state_label": {
            "label": "Status"
          }
        }
      },
      "type": "table"
    }
  },
  "queries": {
    "data": {
      "columns": [
        "post",
        "post_id",
        "region",
        "state",
        "state_label",
        "position",
        "posts"
      ],
      "values": [
        [
          "Dubai",
          "post-dubai",
          "Middle East",
          "paused",
          "Paused",
          1,
          1
        ],
        [
          "Madrid",
          "post-madrid",
          "Europe",
          "initialized",
          "Initialized",
          2,
          1
        ],
        [
          "Riyadh",
          "post-riyadh",
          "Unknown",
          "closed",
          "Closed",
          3,
          1
        ],
        [
          "Tokyo",
          "post-tokyo",
          "Asia Pacific",
          "opened",
          "Opened",
          4,
          1
        ]
      ]
    }
  },
  "rows": [
    "posts"
  ],
  "style": {
    "accent": "#1d4ed8",
    "charts": {
      "axis": {
        "title": {
          "font": {
            "case": "none"
          }
        }
      },
      "callout": {
        "title": {
          "font": {
            "case": "none"
          }
        }
      },
      "category_colors": {
        "group": {
          "values": {
            "Unknown": "dbt-grays.muted"
          }
        }
      },
      "kpi": {
        "label": {
          "font": {
            "case": "none"
          }
        }
      },
      "legend": {
        "title": {
          "font": {
            "case": "none"
          }
        }
      },
      "support_table": {
        "label": {
          "font": {
            "case": "none"
          }
        }
      },
      "table": {
        "header": {
          "font": {
            "case": "none"
          }
        }
      }
    },
    "footer": {
      "visible": false
    },
    "timestamp": {
      "visible": false
    },
    "title": {
      "font": {
        "case": "none"
      }
    }
  },
  "theme": "clarity"
}
