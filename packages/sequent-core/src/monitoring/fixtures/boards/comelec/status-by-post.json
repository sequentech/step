{
  "charts": {
    "posts": {
      "conditional_formatting": {
        "state_label": {
          "when": [
            {
              "background": "positive.bg",
              "eq": "Opened"
            },
            {
              "background": "warning.bg",
              "eq": "Paused"
            },
            {
              "background": "dbt-grays.border",
              "eq": "Closed"
            }
          ]
        }
      },
      "query": "data",
      "style": {
        "columns": {
          "position": {
            "visible": false
          },
          "post": {
            "label": "Post"
          },
