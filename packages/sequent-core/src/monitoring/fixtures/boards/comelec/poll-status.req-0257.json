          1,
          1,
          1.0,
          "100.0%"
        ],
        [
          "Unknown",
          "__unknown__",
          4,
          1,
          1,
          1.0,
          "100.0%"
        ]
      ]
    },
    "states": {
      "columns": [
        "group",
        "group_key",
        "position",
        "posts"
      ],
      "values": [
        [
          "Not initialized",
          "not_initialized",
          1,
          0
        ],
        [
          "Initialized",
          "initialized",
