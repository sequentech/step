{
  "charts": {
    "reached": {
      "label": "Posts that reached the milestone",
      "query": "milestone",
      "support": {
        "format": "integer",
        "label": "Posts",
        "value": "numerator"
      },
      "type": "kpi",
      "value": "pct_label"
    },
    "regions": {
      "query": "regions",
      "sort": {
        "by": "position",
        "order": "asc"
      },
      "style": {
        "marks": {
          "bar": {
            "labels": {
              "format": "percent",
              "visible": true
            }
          }
        },
        "number_format": "percent",
        "orientation": "horizontal"
      },
      "title": "By region",
      "type": "bar",
      "x": "group",
      "y": "pct"
    },
    "states": {
      "color": "group",
      "query": "states",
      "theta": "posts",
      "title": "Posts by current state",
      "total": {
        "visible": false
      },
      "type": "donut"
    }
  },
  "queries": {
    "milestone": {
      "columns": [
        "numerator",
        "denominator",
        "pct",
        "pct_label"
      ],
      "values": [
        [
          3,
          4,
          0.75,
          "75.0%"
        ]
      ]
    },
    "regions": {
      "columns": [
        "group",
        "group_key",
        "position",
        "numerator",
        "denominator",
        "pct",
        "pct_label"
      ],
      "values": [
        [
          "Europe",
          "Europe",
          1,
          0,
          1,
          0.0,
          "0.0%"
        ],
        [
          "Asia Pacific",
          "Asia Pacific",
