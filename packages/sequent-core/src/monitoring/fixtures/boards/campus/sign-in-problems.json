{
  "charts": {
    "problems": {
      "query": "data",
      "sort": {
        "by": "position",
        "order": "asc"
      },
      "style": {
        "axis_y": {
          "ticks": {
            "step": 1
          }
        },
        "marks": {
          "bar": {
            "labels": {
              "format": "number",
              "visible": true
            }
          }
        },
        "number_format": "number",
        "orientation": "horizontal"
      },
      "type": "bar",
      "x": "label",
      "y": "value",
      "y_label": "Attempts"
    }
  },
  "queries": {
    "data": {
      "columns": [
        "measure",
        "label",
        "position",
        "value"
      ],
      "values": [
        [
          "login_failures",
          "Failed sign-ins",
          1,
          180
        ],
        [
          "password_resets",
          "Password reset",
          2,
          40
        ]
      ]
    }
  },
  "rows": [
    "problems"
  ],
  "style": {
    "accent": "#0f766e",
    "charts": {
      "axis": {
        "title": {
          "font": {
            "case": "none"
          }
        }
      },
      "callout": {
        "title": {
          "font": {
            "case": "none"
          }
        }
      },
      "category_colors": {
        "group": {
          "values": {
            "Not stated": "dbt-grays.muted"
          }
        }
      },
      "kpi": {
        "label": {
          "font": {
            "case": "none"
          }
        }
      },
      "legend": {
        "title": {
          "visible": false
        }
      },
      "support_table": {
        "label": {
          "font": {
            "case": "none"
          }
        }
      },
      "table": {
        "header": {
          "font": {
            "case": "none"
          }
        }
      }
    },
    "footer": {
      "visible": false
    },
    "timestamp": {
      "visible": false
    },
    "title": {
      "font": {
        "case": "none"
      }
    }
  },
  "theme": "paper"
}
