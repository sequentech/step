{
  "auth_presets": [
    {
      "deployment_settings": [
        {
          "config_alias": "scanovate-registration",
          "key": "liveness-url",
          "parameter": "scanovate_liveness_url"
        }
      ],
      "name": "biometric_authentication",
      "optional_parameters": [
        "scanovate_ocr_url",
        "scanovate_liveness_url",
        "scanovate_face_match_url",
        "accepted_passport_countries",
        "scanovate_face_match_min_similarity",
        "otp_sender_id",
        "otp_length",
        "otp_ttl_seconds"
      ],
      "parameter_defaults": {
        "accepted_passport_countries": "ESP|PHL|ISR|NLD",
        "otp_length": "6",
        "otp_sender_id": "Sequent",
        "otp_ttl_seconds": "300",
        "scanovate_face_match_min_similarity": "0.67",
        "scanovate_face_match_url": "http://scanovate-face-match:3000",
        "scanovate_ocr_url": "http://scanovate-ocr:5040"
      },
      "patch": {
        "patch": {
          "authenticationFlows": [
            {
              "alias": "biometric-registration",
              "authenticationExecutions": [
                {
                  "authenticator": "registration-page-form",
                  "authenticatorFlow": true,
                  "autheticatorFlow": true,
                  "flowAlias": "biometric-registration registration form",
                  "priority": 10,
                  "requirement": "REQUIRED",
                  "userSetupAllowed": false
                },
                {
                  "authenticator": "message-otp-authenticator",
                  "authenticatorConfig": "biometric-registration-otp",
                  "authenticatorFlow": false,
                  "autheticatorFlow": false,
                  "priority": 17,
                  "requirement": "REQUIRED",
                  "userSetupAllowed": false
                },
                {
                  "authenticator": "scanovate-authenticator",
                  "authenticatorConfig": "scanovate-registration",
                  "authenticatorFlow": false,
                  "autheticatorFlow": false,
                  "priority": 18,
                  "requirement": "REQUIRED",
                  "userSetupAllowed": false
                },
                {
                  "authenticatorFlow": true,
                  "autheticatorFlow": true,
                  "flowAlias": "passport-country-check",
                  "priority": 19,
                  "requirement": "CONDITIONAL",
                  "userSetupAllowed": false
                },
                {
                  "authenticator": "lookup-and-update-user",
                  "authenticatorConfig": "biometric-lookup-register",
                  "authenticatorFlow": false,
                  "autheticatorFlow": false,
                  "priority": 20,
                  "requirement": "REQUIRED",
                  "userSetupAllowed": false
                }
              ],
              "builtIn": false,
              "description": "registration flow",
              "providerId": "basic-flow",
              "topLevel": true
            },
            {
              "alias": "biometric-registration registration form",
              "authenticationExecutions": [
                {
                  "authenticator": "enrollment-window-check",
                  "authenticatorFlow": false,
                  "autheticatorFlow": false,
                  "priority": 0,
                  "requirement": "REQUIRED",
                  "userSetupAllowed": false
                },
                {
                  "authenticator": "deferred-registration-user-creation",
                  "authenticatorConfig": "biometric-registration-user",
                  "authenticatorFlow": false,
                  "autheticatorFlow": false,
                  "priority": 10,
                  "requirement": "REQUIRED",
                  "userSetupAllowed": false
                }
              ],
              "builtIn": false,
              "description": "registration form",
              "providerId": "form-flow",
              "topLevel": false
            },
            {
              "alias": "passport-country-check",
              "authenticationExecutions": [
                {
                  "authenticator": "conditional-auth-note",
                  "authenticatorConfig": "passport-country-not-accepted",
                  "authenticatorFlow": false,
                  "autheticatorFlow": false,
                  "priority": 0,
                  "requirement": "REQUIRED",
                  "userSetupAllowed": false
                },
                {
                  "authenticator": "deny-access-authenticator",
                  "authenticatorConfig": "passport-country-denied",
                  "authenticatorFlow": false,
                  "autheticatorFlow": false,
                  "priority": 10,
                  "requirement": "REQUIRED",
                  "userSetupAllowed": false
                }
              ],
              "builtIn": false,
              "description": "refuse a passport issued outside the accepted countries",
              "providerId": "basic-flow",
              "topLevel": false
            }
          ],
          "authenticatorConfig": [
            {
              "alias": "biometric-registration-otp",
              "config": {
                "code-progress-policy": "SHOW",
                "deferredUserAttribute": "true",
                "length": "{{otp_length}}",
                "messageCourierAttribute": "CHOSEN",
                "one-time-link": "false",
                "resendCoudActivationTimer": "60",
                "senderId": "{{otp_sender_id}}",
                "telUserAttribute": "sequent.read-only.mobile-number",
                "ttl": "{{otp_ttl_seconds}}"
              }
            },
            {
              "alias": "scanovate-registration",
              "config": {
                "attributes-to-store": "{\"philippinePassport\":[{\"UserAttribute\":\"firstName\",\"attributePath\":\"/first_name_english\",\"process\":\"ocr\",\"type\":\"text\"},{\"UserAttribute\":\"lastName\",\"attributePath\":\"/last_name_english\",\"process\":\"ocr\",\"type\":\"text\"},{\"UserAttribute\":\"sequent.read-only.id-card-number\",\"attributePath\":\"/document_number\",\"process\":\"ocr\",\"type\":\"text\"},{\"UserAttribute\":\"dateOfBirth\",\"attributePath\":\"/date_of_birth\",\"process\":\"ocr\",\"sourceDateFormat\":\"yyyy-MM-dd\",\"storeDateFormat\":\"yyyy-MM-dd\",\"type\":\"date\"},{\"UserAttribute\":\"issuingCountry\",\"attributePath\":\"/issuing_country_code\",\"process\":\"ocr\",\"type\":\"text\"}]}",
                "attributes-to-validate": "{\"philippinePassport\":[{\"attributePath\":\"/date_of_expiry\",\"errorMsg\":\"scanovateAttributesError\",\"isBeforeDateValue\":\"now\",\"process\":\"ocr\",\"sourceDateFormat\":\"yyyy-MM-dd\",\"type\":\"isBeforeDateValue\"}]}",
                "capture-sides": "{\"philippinePassport\": [\"front\"]}",
                "doc-id-type": "sequent.read-only.id-card-type",
                "face-match-min-similarity": "{\"philippinePassport\": {{scanovate_face_match_min_similarity}}}",
                "face-match-url": "{{scanovate_face_match_url}}",
                "liveness-url": "{{scanovate_liveness_url}}",
                "max-attempts": "3",
                "ocr-types": "{\"philippinePassport\": \"passport\"}",
                "ocr-url": "{{scanovate_ocr_url}}",
                "user-status": "sequent.read-only.id-card-number-validated"
              }
            },
            {
              "alias": "biometric-registration-user",
              "config": {
                "channel-choice-policy": "OTP_CHANNELS",
                "user-status": "sequent.read-only.id-card-number-validated"
              }
            },
            {
              "alias": "biometric-lookup-register",
              "config": {
                "auto-2fa": "true",
                "auto-login": "false",
                "messageCourierAttribute": "CHOSEN",
                "no-matching-voter-policy": "PENDING_APPROVAL",
                "reply-by-hours": "72",
                "search-attributes": "firstName,middleName,lastName,dateOfBirth",
                "telUserAttribute": "sequent.read-only.mobile-number",
                "unset-attributes": "email,sequent.read-only.mobile-number,sequent.read-only.id-card-number-validated",
                "update-attributes": "sequent.read-only.id-card-number-validated,email,sequent.read-only.mobile-number,sequent.read-only.id-card-number,sequent.read-only.id-card-type"
              }
            },
            {
              "alias": "passport-country-not-accepted",
              "config": {
                "conditional-auth-note-key": "issuingCountry",
                "conditional-auth-note-value": "(?i)\\s*({{accepted_passport_countries}})\\s*",
                "negate": "true",
                "value-is-regex": "true"
              }
            },
            {
              "alias": "passport-country-denied",
              "config": {
                "denyErrorMessage": "passportCountryNotAccepted"
              }
            }
          ],
          "localizationTexts": {
            "en": {
              "issuingCountry": "Issuing country",
              "passportCountryNotAccepted": "Passports issued by this country can't be used to enroll.",
              "philippinePassport": "Passport"
            },
            "tl": {
              "issuingCountry": "Bansang nag-isyu",
              "passportCountryNotAccepted": "Hindi maaaring gamitin sa pagpapatala ang pasaporteng inisyu ng bansang ito.",
              "philippinePassport": "Pasaporte"
            }
          },
          "loginTheme": "sequent-ui-voting",
          "registrationFlow": "biometric-registration"
        }
      },
      "profile_attributes": [
        "middleName",
        "dateOfBirth",
        "mobile",
        "sequent.read-only.id-card-type",
        "sequent.read-only.id-card-number",
        "sequent.read-only.id-card-number-validated"
      ],
      "required_parameters": [],
      "requires": [
        {
          "kind": "authenticator",
          "name": "scanovate-authenticator",
          "why": "the passport and selfie are verified by this provider, which only the ovcs Keycloak image ships"
        },
        {
          "kind": "authenticator",
          "name": "conditional-auth-note",
          "why": "the passport's issuing country is checked by this condition"
        },
        {
          "kind": "authenticator",
          "name": "deny-access-authenticator",
          "why": "a passport from a country that is not accepted is refused by this step"
        }
      ],
      "summary": "Biometric Authentication: the voter enrolls with their passport and a live selfie verified by Scanovate, after a one-time code, and is matched against the census.",
      "uses_otp": true
    },
    {
      "name": "digital_certificates",
      "optional_parameters": [],
      "parameter_defaults": {},
      "patch": {
        "patch": {
          "identityProviders": [
            {
              "addReadTokenRoleOnCreate": false,
              "alias": "digital-certificates",
              "authenticateByDefault": false,
              "displayName": "Digital Certificates",
              "enabled": true,
              "firstBrokerLoginFlowAlias": "certificate-first-login-flow",
              "linkOnly": false,
              "providerId": "keycloak-oidc",
              "storeToken": false,
              "trustEmail": false,
              "updateProfileFirstLoginMode": "off"
            }
          ],
          "registrationAllowed": false,
          "resetPasswordAllowed": false
        }
      },
      "profile_attributes": [],
      "required_parameters": [],
      "requires": [
        {
          "kind": "flow",
          "name": "certificate-first-login-flow",
          "why": "a first-time certificate login is handed to this flow"
        }
      ],
      "summary": "The voter presents a digital certificate, brokered through the platform's digital-certificates provider.",
      "uses_otp": false
    },
    {
      "name": "otp_email_or_sms",
      "optional_parameters": [
        "otp_sender_id",
        "otp_length",
        "otp_ttl_seconds"
      ],
      "parameter_defaults": {
        "otp_length": "6",
        "otp_sender_id": "Sequent",
        "otp_ttl_seconds": "900"
      },
      "patch": {
        "bind_authenticator_config": {
          "authenticator": "message-otp-authenticator",
          "config_alias": "janitor-otp-by-availability"
        },
        "patch": {
          "authenticatorConfig": [
            {
              "alias": "janitor-otp-by-availability",
              "config": {
                "deferredUserAttribute": "false",
                "length": "{{otp_length}}",
                "max-receiver-reuse": "1",
                "messageCourierAttribute": "BOTH",
                "one-time-link": "false",
                "resendCoudActivationTimer": "60",
                "senderId": "{{otp_sender_id}}",
                "telUserAttribute": "sequent.read-only.mobile-number",
                "test-mode": "false",
                "ttl": "{{otp_ttl_seconds}}"
              }
            }
          ],
          "bruteForceProtected": true,
          "loginWithEmailAllowed": false,
          "registrationAllowed": true,
          "registrationEmailAsUsername": false,
          "resetPasswordAllowed": false
        }
      },
      "profile_attributes": [
        "email",
        "mobile"
      ],
      "required_parameters": [],
      "requires": [
        {
          "kind": "authenticator",
          "name": "message-otp-authenticator",
          "why": "the one-time code step is bound to this authenticator's config"
        }
      ],
      "summary": "The voter types their member id, then a one-time code sent to whichever of email and mobile the census holds for them.",
      "uses_otp": true
    },
    {
      "name": "saml_sso_idp_initiated",
      "optional_parameters": [
        "saml_idp_alias",
        "saml_principal_attribute"
      ],
      "parameter_defaults": {
        "saml_idp_alias": "client-saml-idp",
        "saml_idp_metadata_url": "",
        "saml_principal_attribute": "username"
      },
      "patch": {
        "patch": {
          "identityProviders": [
            {
              "addReadTokenRoleOnCreate": false,
              "alias": "{{saml_idp_alias}}",
              "authenticateByDefault": false,
              "config": {
                "allowCreate": "false",
                "allowedClockSkew": "30",
                "authnContextComparisonType": "exact",
                "backchannelSupported": "false",
                "enabledFromMetadata": "true",
                "forceAuthn": "false",
                "hideOnLoginPage": "false",
                "metadataDescriptorUrl": "{{saml_idp_metadata_url}}",
                "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:2.0:nameid-format:transient",
                "postBindingAuthnRequest": "true",
                "postBindingLogout": "true",
                "postBindingResponse": "true",
                "principalAttribute": "{{saml_principal_attribute}}",
                "principalType": "ATTRIBUTE",
                "signSpMetadata": "false",
                "syncMode": "IMPORT",
                "validateSignature": "true",
                "wantAssertionsEncrypted": "false",
                "wantAssertionsSigned": "true",
                "wantAuthnRequestsSigned": "false"
              },
              "displayName": "Sign in with your organisation",
              "enabled": true,
              "firstBrokerLoginFlowAlias": "saml-first-broker-flow",
              "linkOnly": false,
              "providerId": "saml",
              "storeToken": false,
              "trustEmail": false,
              "updateProfileFirstLoginMode": "off"
            }
          ],
          "loginWithEmailAllowed": false,
          "registrationAllowed": false,
          "rememberMe": false,
          "resetPasswordAllowed": false
        }
      },
      "profile_attributes": [],
      "required_parameters": [
        "saml_idp_metadata_url"
      ],
      "requires": [
        {
          "kind": "flow",
          "name": "saml-first-broker-flow",
          "why": "a first-time SAML login is handed to this flow to match the assertion against an existing census voter"
        }
      ],
      "summary": "The client's SAML identity provider authenticates the voter and posts an assertion to Keycloak. Voters need no email address or mobile number.",
      "uses_otp": false
    },
    {
      "name": "voter_link_plus_dob",
      "optional_parameters": [
        "otp_sender_id",
        "otp_length",
        "otp_ttl_seconds"
      ],
      "parameter_defaults": {
        "otp_length": "6",
        "otp_sender_id": "Sequent",
        "otp_ttl_seconds": "900"
      },
      "patch": {
        "bind_authenticator_config": {
          "authenticator": "message-otp-authenticator",
          "config_alias": "janitor-otp-by-availability"
        },
        "patch": {
          "authenticatorConfig": [
            {
              "alias": "janitor-otp-by-availability",
              "config": {
                "deferredUserAttribute": "false",
                "length": "{{otp_length}}",
                "max-receiver-reuse": "1",
                "messageCourierAttribute": "BOTH",
                "one-time-link": "false",
                "resendCoudActivationTimer": "60",
                "senderId": "{{otp_sender_id}}",
                "telUserAttribute": "sequent.read-only.mobile-number",
                "test-mode": "false",
                "ttl": "{{otp_ttl_seconds}}"
              }
            },
            {
              "alias": "deferred",
              "config": {
                "form-mode": "LOGIN",
                "hidden-profile-attributes": "locale,firstName,lastName,ssn4",
                "password-expiration-user-attribute": "sequent.read-only.expirationDate",
                "password-required": "false",
                "prefill-parameters-policy": "ACCEPT",
                "search-attributes": "username,dateOfBirth",
                "user-status": "sequent.read-only.id-card-number-validated"
              }
            }
          ],
          "bruteForceProtected": true,
          "loginWithEmailAllowed": false,
          "registrationAllowed": true,
          "registrationEmailAsUsername": false,
          "resetPasswordAllowed": false
        },
        "user_profile": {
          "dateOfBirth": {
            "annotations": {
              "inputType": "html5-date",
              "loginHintPrefillPolicy": "IGNORE"
            },
            "permissions": {
              "edit": [
                "admin",
                "user"
              ],
              "view": [
                "admin",
                "user"
              ]
            },
            "required": {
              "roles": [
                "user"
              ]
            }
          },
          "username": {
            "annotations": {
              "loginHintPrefillPolicy": "READ_ONLY"
            },
            "permissions": {
              "edit": [
                "admin",
                "user"
              ],
              "view": [
                "admin",
                "user"
              ]
            }
          }
        }
      },
      "profile_attributes": [
        "dateOfBirth",
        "mobile"
      ],
      "required_parameters": [],
      "requires": [
        {
          "kind": "authenticator",
          "name": "message-otp-authenticator",
          "why": "the one-time code step is bound to this authenticator's config"
        },
        {
          "kind": "authenticator_config",
          "name": "deferred",
          "why": "the login form's fields and prefill policy are set on this config"
        }
      ],
      "summary": "A voter-specific link carries the member id read-only; the voter types their date of birth, then a one-time code.",
      "uses_otp": true
    }
  ],
  "defaults": {},
  "display_name": "Sequent's own",
  "hidden": [],
  "id": "default",
  "locked": [],
  "required": []
}
