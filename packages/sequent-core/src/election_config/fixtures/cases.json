  {
    "name": "tally-disagrees-with-voting-type",
    "why": "A preferential ballot counted by a plurality algorithm. Both values are individually valid, which is why nothing else catches it.",
    "patch": {
      "contests": [
        {
          "id": "c1000000-0000-5000-8000-000000000000",
          "tenant_id": "11111111-1111-4111-8111-111111111111",
          "election_event_id": "e0000000-0000-5000-8000-000000000000",
          "election_id": "e1000000-0000-5000-8000-000000000000",
