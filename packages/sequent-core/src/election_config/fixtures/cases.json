  {
    "name": "election-hidden-by-a-permission-label",
    "why": "The one that cost a real import. A labelled election is invisible to every administrator without that label, so the event imports cleanly and the Elections list is empty.",
    "patch": {
      "elections": [
        {
          "id": "e1000000-0000-5000-8000-000000000000",
          "tenant_id": "11111111-1111-4111-8111-111111111111",
          "election_event_id": "e0000000-0000-5000-8000-000000000000",
          "external_id": "officers",
          "permission_label": "statewide-officers"
        }
      ]
    },
    "expect": {"errors": [], "warnings": ["permission_label"]}
