  {
    "name": "nothing-on-any-ballot",
    "why": "No area/contest links at all. A warning, not an error: an event still being configured looks exactly like this, and its export has to round trip for disaster recovery.",
    "patch": {"area_contests": []},
    "expect": {"errors": [], "warnings": ["ballot_coverage"]}
