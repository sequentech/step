{
  "name": "@sequentech/workbench-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build:sequent-core": "node scripts/prepare-sequent-core.mjs",
    "build:wasm": "cd ../velvet-wasm && wasm-pack build --target web --out-dir pkg",
    "predev": "yarn build:wasm && yarn build:sequent-core",
    "prebuild": "yarn build:wasm && yarn build:sequent-core",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@apollo/client": "4.0.5",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.2",
    "@mui/material": "7.3.2",
    "@mui/x-data-grid": "8.17.0",
    "@reduxjs/toolkit": "2.10.1",
    "@sequentech/ui-core": "*",
    "@sequentech/ui-essentials": "*",
    "graphql": "16.11.0",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-i18next": "15.7.3",
    "react-redux": "9.2.0",
    "react-router": "7.12.0",
    "react-router-dom": "7.12.0",
    "velvet-wasm": "file:../velvet-wasm/pkg",
    "voting-portal": "*"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.4.1"
  }
}
