{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@sequentech/ui-core": ["../ui-core/src/index.tsx"],
      "@sequentech/ui-essentials": ["../ui-essentials/src/index.tsx"]
    }
  },
  "include": [
    "src",
    "tests",
    "playwright.config.ts",
    "../ui-essentials/src/**/*.d.ts",
    "../voting-portal/src/types/index.d.ts"
  ],
  "exclude": ["node_modules", "dist", "test-results"]
}
