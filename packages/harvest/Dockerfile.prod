# Optional offline dependency source. The default, scratch, copies an empty
# directory into the builder and leaves the online build byte-identical. Point it
# at packages/Dockerfile.offline-dependencies' output to resolve dependencies from
# vendored inputs instead of a registry:
#   --build-arg VENDOR_IMAGE=sequentech.local/offline-dependencies:latest
#
# This is not yet enough for --network=none: the stages below still install
# operating-system packages, and some download tools over HTTPS. See the scope
# note in packages/Dockerfile.offline-dependencies for the full list.
# See sequentech/meta#13625.
# Debian archive snapshot every apt call resolves against. Pinning the archive
# state, rather than individual package versions, is what makes the dependency
# closure identical on a client's machine and on ours: pinning only the packages
# we name leaves their dependencies to whatever the live mirror serves that day
# (installing wget with its version pinned still resolves libpsl5 from the
# mirror). See sequentech/meta#13625.
#
# http, not https: these base images ship no CA certificates, so an https source
# fails before anything is installed. apt verifies the signed InRelease and the
# per-file checksums regardless of transport.
#
# Bumping this is a deliberate release action, like bumping a base image digest:
# it changes what the build contains, so it produces a new release identity. A
# pinned snapshot also stops picking up security updates until it is bumped.
ARG DEBIAN_SNAPSHOT=20260929T000000Z

ARG VENDOR_IMAGE=scratch
FROM ${VENDOR_IMAGE} AS vendor

FROM rust:1.96.0-slim-bookworm@sha256:4732ca96fd086cb9be682050c3f0176288eebaac2b80aa2bcefccfaf198e1950 as builder

WORKDIR /app

# Resolve apt against the pinned snapshot rather than the live mirror.
ARG DEBIAN_SNAPSHOT
RUN set -eux; \
    rm -f /etc/apt/sources.list.d/debian.sources; \
    { \
      echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm main"; \
      echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm-updates main"; \
      echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT} bookworm-security main"; \
    } > /etc/apt/sources.list

RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    protobuf-compiler \
    libprotobuf-dev \
    m4 \
    make \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*


#TODO: Copy only necessary files
COPY ./braid ./braid
COPY ./b4 ./b4
COPY ./electoral-log ./electoral-log
COPY ./harvest ./harvest
COPY ./strand ./strand
COPY ./immu-board ./immu-board
COPY ./immudb-rs ./immudb-rs
COPY ./sequent-core ./sequent-core
COPY ./velvet ./velvet
COPY ./windmill ./windmill
COPY ./e2e ./e2e
COPY ./step-cli ./step-cli
COPY ./orare ./orare
COPY ./wrap-map-err ./wrap-map-err
COPY ./braid/scripts ./braid/scripts
COPY ./plugins ./plugins
COPY ./Cargo.toml ./Cargo.toml
COPY ./Cargo.lock ./Cargo.lock
COPY ./.cargo ./.cargo

# Use the vendored crates when a vendor image was supplied, otherwise fetch as
# before. cargo vendor writes an absolute directory into its config, so the path
# is rewritten to where the cache actually landed here.
#
# net.offline is set in the same branch so an incomplete vendor fails loudly
# instead of quietly reaching for crates.io -- which would make an "offline"
# build silently depend on the network it is meant to prove it does not need.
COPY --from=vendor / /vendor/
RUN if [ -d /vendor/vendor-cache ]; then \
        mkdir -p .cargo && \
        { echo; sed 's|^directory = .*|directory = "/vendor/vendor-cache"|' \
            /vendor/vendor-cache/config.toml; } >> .cargo/config.toml && \
        printf '\n[net]\noffline = true\n' >> .cargo/config.toml && \
        echo "offline build: using vendored crates from /vendor/vendor-cache"; \
    fi

RUN cp /app/windmill/external-bin/ecies-tool.jar /usr/local/bin/

WORKDIR /app/harvest
RUN cargo build --release --locked


FROM debian:bookworm@sha256:f37a335e82bca302e955fa39f9dfe28f1be618f016f8a2b56318e5a5111afc26
ENV ROCKET_ADDRESS=0.0.0.0
ENV ROCKET_PORT=8400
EXPOSE 8400
# Some shared libraries (extra-runtime-dependencies) may need to be installed:
# Install any necessary runtime dependencies for production

# Resolve apt against the pinned snapshot rather than the live mirror. This stage
# also wants bookworm-proposed-updates, which the snapshot carries, so the suite
# is kept -- pinned -- rather than dropped.
ARG DEBIAN_SNAPSHOT
RUN set -eux; \
    rm -f /etc/apt/sources.list.d/debian.sources; \
    { \
      echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm main"; \
      echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm-updates main"; \
      echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm-proposed-updates main"; \
      echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT} bookworm-security main"; \
    } > /etc/apt/sources.list

# The package manager's logs carry the time of the build, so they are removed in
# the layer that writes them: two builds of the same commit must give the same
# layer (sequentech/meta#13625).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libssl3 chromium ca-certificates wget software-properties-common \
    && rm -rf /var/lib/apt/lists/* /var/log/apt /var/log/dpkg.log /var/log/alternatives.log
RUN update-ca-certificates

# Use Docker build arguments to determine the architecture
ARG TARGETARCH

# Set Java version
ENV JAVA_VERSION=22.0.2
ENV JAVA_BUILD=c9ecb94cd31b495da20a27d4581645e8/9

# Default to linux-x64, which is the most common.
# This will be overridden by the conditional logic below.
ENV JAVA_OS_ARCH=linux-x64
ENV JAVA_FILENAME=openjdk-${JAVA_VERSION}_linux-x64_bin.tar.gz

# Conditional logic to set the correct download URL and filename based on architecture
RUN case "${TARGETARCH}" in \
    "amd64") \
        export JAVA_OS_ARCH=linux-x64; \
        export JAVA_FILENAME=openjdk-${JAVA_VERSION}_linux-x64_bin.tar.gz; \
        ;; \
    "arm64") \
        export JAVA_OS_ARCH=linux-aarch64; \
        export JAVA_FILENAME=openjdk-${JAVA_VERSION}_linux-aarch64_bin.tar.gz; \
        ;; \
    *) \
        echo "Unsupported architecture: ${TARGETARCH}"; \
        exit 1; \
        ;; \
    esac; \
    echo "Downloading OpenJDK for ${JAVA_OS_ARCH}"; \
    echo "Download url https://download.java.net/java/GA/jdk${JAVA_VERSION}/${JAVA_BUILD}/GPL/${JAVA_FILENAME}"; \
    echo "JAVA_FILENAME=${JAVA_FILENAME}" >> /etc/profile.d/java.sh; \
    wget https://download.java.net/java/GA/jdk${JAVA_VERSION}/${JAVA_BUILD}/GPL/${JAVA_FILENAME} \
    && tar xvf ${JAVA_FILENAME} \
    && mv jdk-${JAVA_VERSION} /usr/local/ \
    && update-alternatives --install /usr/bin/java java /usr/local/jdk-${JAVA_VERSION}/bin/java 1 \
    && update-alternatives --install /usr/bin/javac javac /usr/local/jdk-${JAVA_VERSION}/bin/javac 1 \
    && curl -L --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash \
    && rm -f /var/log/alternatives.log
# Copy the compiled binary from the builder stage
COPY --from=builder /app/target/release/harvest /usr/local/bin/harvest
COPY --from=builder /usr/local/bin/ecies-tool.jar /usr/local/bin/ecies-tool.jar

WORKDIR /usr/local/bin

# Run the application
CMD ["harvest"]