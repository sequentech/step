FROM rust:1.96.0-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    protobuf-compiler \
    libprotobuf-dev \
    m4 \
    make \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

#TODO: Copy only necessary files
COPY . .

WORKDIR /app/windmill
RUN cargo fetch --locked
