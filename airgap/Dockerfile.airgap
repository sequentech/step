FROM rust:1.90.0-slim-bookworm

# Install Node.js and Yarn
RUN apt-get update && apt-get install -y curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g yarn \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install build essentials and other tools from devenv.nix
RUN apt-get update && apt-get install -y \
    build-essential \
    m4 \
    make \
    chromium \
    libssl-dev \
    protobuf-compiler \
    libprotobuf-dev \
    pkg-config \
    wget \
    git \
    vim \
    ack \
    postgresql-client \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Force Cargo and Yarn to operate in offline mode
ENV CARGO_NET_OFFLINE=true
# For Yarn, we'll use the offline mirror configured via .yarnrc or environment
ENV YARN_OFFLINE_MIRROR=/workspace/packages/npm-packages-offline-cache

# Keeps the container running passively in the background
CMD ["sleep", "infinity"]
